  <skos:Concept rdf:about="https://w3id.org/wco-dm/4.3.0#CV_TransitPassengerIndicatorCode_0">
    <skos:inScheme rdf:resource="https://w3id.org/wco-dm/4.3.0#CL_TransitPassengerIndicatorCode"/>
    <skos:notation>0</skos:notation>
    <skos:prefLabel xml:lang="en">0</skos:prefLabel>
    <skos:definition xml:lang="en">Off (Passenger leaves ship during visit)</skos:definition>
  </skos:Concept>
  <skos:Concept rdf:about="https://w3id.org/wco-dm/4.3.0#CV_TransitPassengerIndicatorCode_1">
    <skos:inScheme rdf:resource="https://w3id.org/wco-dm/4.3.0#CL_TransitPassengerIndicatorCode"/>
    <skos:notation>1</skos:notation>
    <skos:prefLabel xml:lang="en">1</skos:prefLabel>
    <skos:definition xml:lang="en">Transit (Transit = Yes, meaning: passenger stays on board during the visit)</skos:definition>
  </skos:Concept>
  <skos:Concept rdf:about="https://w3id.org/wco-dm/4.3.0#CV_TransitPassengerIndicatorCode_2">
    <skos:inScheme rdf:resource="https://w3id.org/wco-dm/4.3.0#CL_TransitPassengerIndicatorCode"/>
    <skos:notation>2</skos:notation>
    <skos:prefLabel xml:lang="en">2</skos:prefLabel>
    <skos:definition xml:lang="en">On (Passenger has left the vessel during the visit but is on board again)</skos:definition>
  </skos:Concept>
