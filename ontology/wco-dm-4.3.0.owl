    <wco:modelPathInstance>OIS/CIS/Consignment/ConsignmentItem/AdditionalDocument</wco:modelPathInstance>
    <wco:modelPathInstance>OIS/CIS/Consignment/ConsignmentItem/Commodity/AdditionalDocument</wco:modelPathInstance>
    <wco:modelPathInstance>OIS/CIS/Consignment/GoodsItem/AdditionalDocument</wco:modelPathInstance>
    <wco:branch>999</wco:branch>
    <wco:occurrenceCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">19</wco:occurrenceCount>
    <wco:superClass>SC1 RootDocument</wco:superClass>
