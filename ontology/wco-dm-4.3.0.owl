  <skos:Concept rdf:about="https://w3id.org/wco-dm/4.3.0#CV_INFShipClassCode_INF1">
    <skos:inScheme rdf:resource="https://w3id.org/wco-dm/4.3.0#CL_INFShipClassCode"/>
    <skos:notation>INF1</skos:notation>
    <skos:prefLabel xml:lang="en">INF1</skos:prefLabel>
    <skos:definition xml:lang="en">Ships which are certified to carry INF cargo with an aggregate activity less than 4,000 TBq</skos:definition>
  </skos:Concept>
  <skos:Concept rdf:about="https://w3id.org/wco-dm/4.3.0#CV_INFShipClassCode_INF2">
    <skos:inScheme rdf:resource="https://w3id.org/wco-dm/4.3.0#CL_INFShipClassCode"/>
    <skos:notation>INF2</skos:notation>
    <skos:prefLabel xml:lang="en">INF2</skos:prefLabel>
    <skos:definition xml:lang="en">Ships which are certified to carry irradiated nuclear fuel or high-level radioactive wastes with an aggregate activity less than 2 x 106 TBq and ships which are certified to carry plutonium with an aggregate activity less than 2??105 TBq</skos:definition>
  </skos:Concept>
  <skos:Concept rdf:about="https://w3id.org/wco-dm/4.3.0#CV_INFShipClassCode_INF3">
    <skos:inScheme rdf:resource="https://w3id.org/wco-dm/4.3.0#CL_INFShipClassCode"/>
    <skos:notation>INF3</skos:notation>
    <skos:prefLabel xml:lang="en">INF3</skos:prefLabel>
    <skos:definition xml:lang="en">Ships which are certified to carry irradiated nuclear fuel or high-level radioactive wastes and ships which are certified to carry plutonium with no restriction of the maximum aggregate activity of the materials</skos:definition>
  </skos:Concept>
