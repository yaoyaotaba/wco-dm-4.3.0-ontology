  <owl:Class rdf:about="https://w3id.org/wco-dm/4.3.0#C_OIS">
    <rdfs:subClassOf rdf:resource="https://w3id.org/wco-dm/4.3.0#DataModelComponent"/>
    <rdfs:label xml:lang="en">OIS</rdfs:label>
    <skos:prefLabel xml:lang="en">OIS</skos:prefLabel>
    <rdfs:label xml:lang="zh">总体信息结构</rdfs:label>
    <skos:prefLabel xml:lang="zh">总体信息结构</skos:prefLabel>
    <skos:definition xml:lang="en">Overall Information Structure (OIS): the root container of the WCO Data Model 4.3.0 class hierarchy, comprising the MDIP metadata package and the Content Information Structure (CIS).</skos:definition>
    <dcterms:identifier>OIS</dcterms:identifier>
    <wco:classID>OIS</wco:classID>
    <wco:modelPath>OIS</wco:modelPath>
    <wco:branch>OIS</wco:branch>
    <wco:occurrenceCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</wco:occurrenceCount>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/wco-dm/4.3.0#C_01A">
