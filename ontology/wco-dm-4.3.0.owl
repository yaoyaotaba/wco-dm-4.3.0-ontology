      <owl:Class>
        <owl:unionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="https://w3id.org/wco-dm/4.3.0#C_40C"/>
        <rdf:Description rdf:about="https://w3id.org/wco-dm/4.3.0#C_50A"/>
        <rdf:Description rdf:about="https://w3id.org/wco-dm/4.3.0#C_56C"/>
        </owl:unionOf>
      </owl:Class>
