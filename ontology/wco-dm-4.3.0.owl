  <owl:Class rdf:about="https://w3id.org/wco-dm/4.3.0#C_03A">
    <rdfs:subClassOf rdf:resource="https://w3id.org/wco-dm/4.3.0#DataModelComponent"/>
    <rdfs:label xml:lang="en">AdditionalInformation</rdfs:label>
    <skos:prefLabel xml:lang="en">AdditionalInformation</skos:prefLabel>
    <rdfs:label xml:lang="zh">附加信息</rdfs:label>
    <skos:prefLabel xml:lang="zh">附加信息</skos:prefLabel>
    <skos:definition xml:lang="en">Details related to the special request from declarant to government to take or not to take action.</skos:definition>
    <dcterms:identifier>03A</dcterms:identifier>
    <wco:classID>03A</wco:classID>
    <wco:modelPath>OIS/CIS/AdditionalInformation</wco:modelPath>
    <wco:modelPathInstance>OIS/CIS/Amendment/AdditionalInformation</wco:modelPathInstance>
