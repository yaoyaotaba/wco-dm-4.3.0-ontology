  <!-- WCO Data Model 4.3.0 ontology; RDF/XML serialisation -->
  <owl:Ontology rdf:about="https://w3id.org/wco-dm/4.3.0">
    <rdfs:label xml:lang="en">WCO Data Model 4.3.0 Ontology</rdfs:label>
    <rdfs:label xml:lang="zh">WCO 数据模型 4.3.0 本体</rdfs:label>
    <dcterms:title xml:lang="en">WCO Data Model 4.3.0 Ontology</dcterms:title>
    <dcterms:title xml:lang="zh">WCO 数据模型 4.3.0 本体知识库</dcterms:title>
    <dcterms:description xml:lang="en">An OWL 2 DL ontology of the WCO Data Model 4.3.0, derived from the official LIB and OIS workbooks.</dcterms:description>
    <dcterms:description xml:lang="zh">基于 WCO 数据模型 4.3.0 官方 LIB 与 OIS 工作簿构建的 OWL 2 DL 本体。</dcterms:description>
    <owl:versionIRI rdf:resource="https://w3id.org/wco-dm/4.3.0/version/4.3.0"/>
    <owl:versionInfo>4.3.0</owl:versionInfo>
    <dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-31</dcterms:issued>
    <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-11-01T14:18:35+00:00</dcterms:modified>
    <dcterms:creator>Generated from the official WCO DM 4.3.0 LIB and OIS workbooks</dcterms:creator>
    <dcterms:publisher>WCO Data Model publication package (source data); ontology generated locally</dcterms:publisher>
    <dcterms:source rdf:resource="https://datamodel.wcoomd.org/#/package"/>
    <dcterms:source rdf:resource="https://datamodel.wcoomd.org/datamodel/infopage/4.3.0"/>
    <dcterms:rights xml:lang="en">WCO source data remains subject to the WCO terms of use. This derived ontology is provided for interoperability and analysis; it is not an official WCO publication.</dcterms:rights>
    <vann:preferredNamespacePrefix>wco</vann:preferredNamespacePrefix>
    <vann:preferredNamespaceUri>https://w3id.org/wco-dm/4.3.0#</vann:preferredNamespaceUri>
    <dcterms:conformsTo rdf:resource="http://www.w3.org/TR/owl2-syntax/"/>
    <dcterms:conformsTo rdf:resource="http://www.w3.org/TR/skos-reference/"/>
    <dcterms:conformsTo rdf:resource="http://www.w3.org/TR/shacl/"/>
    <dcterms:conformsTo rdf:resource="http://www.w3.org/TR/prov-o/"/>
    <dcterms:conformsTo rdf:resource="http://www.w3.org/TR/vocab-dcat-3/"/>
    <wco:classCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">274</wco:classCount>
    <wco:objectPropertyCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">273</wco:objectPropertyCount>
    <wco:dataPropertyCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">836</wco:dataPropertyCount>
    <wco:codeListCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">135</wco:codeListCount>
  </owl:Ontology>

  <owl:Class rdf:about="https://w3id.org/wco-dm/4.3.0#DataModelComponent">
    <rdfs:label xml:lang="en">WCO Data Model component</rdfs:label>
    <rdfs:label xml:lang="zh">WCO 数据模型组件</rdfs:label>
    <skos:definition xml:lang="en">The top-level integration class.</skos:definition>
  </owl:Class>

  <owl:ObjectProperty rdf:about="https://w3id.org/wco-dm/4.3.0#hasComponent">
    <rdfs:label xml:lang="en">has component</rdfs:label>
    <rdfs:label xml:lang="zh">包含组件</rdfs:label>
    <skos:definition xml:lang="en">The generic containment relation of the OIS hierarchy. Every role-specific object property is a sub-property of this relation.</skos:definition>
    <rdfs:domain rdf:resource="https://w3id.org/wco-dm/4.3.0#DataModelComponent"/>
    <rdfs:range rdf:resource="https://w3id.org/wco-dm/4.3.0#DataModelComponent"/>
    <owl:inverseOf rdf:resource="https://w3id.org/wco-dm/4.3.0#isComponentOf"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://w3id.org/wco-dm/4.3.0#isComponentOf">
    <rdfs:label xml:lang="en">is component of</rdfs:label>
    <rdfs:label xml:lang="zh">是……的组件</rdfs:label>
    <skos:definition xml:lang="en">The inverse of the generic containment relation.</skos:definition>
    <rdfs:domain rdf:resource="https://w3id.org/wco-dm/4.3.0#DataModelComponent"/>
    <rdfs:range rdf:resource="https://w3id.org/wco-dm/4.3.0#DataModelComponent"/>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/wco-dm/4.3.0#hasAttribute">
    <rdfs:label xml:lang="en">has attribute value</rdfs:label>
    <rdfs:label xml:lang="zh">具有属性值</rdfs:label>
    <skos:definition xml:lang="en">Generic accessor for a WCO data element value. Every WCO data element property is a sub-property of this relation.</skos:definition>
    <rdfs:domain rdf:resource="https://w3id.org/wco-dm/4.3.0#DataModelComponent"/>
    <rdfs:range rdf:resource="http://www.w3.org/2000/01/rdf-schema#Literal"/>
  </owl:DatatypeProperty>

  <owl:AnnotationProperty rdf:about="https://w3id.org/wco-dm/4.3.0#classID">
    <rdfs:label xml:lang="en">WCO class identifier</rdfs:label>
  </owl:AnnotationProperty>
  <owl:AnnotationProperty rdf:about="https://w3id.org/wco-dm/4.3.0#modelPath">
    <rdfs:label xml:lang="en">OIS model path</rdfs:label>
  </owl:AnnotationProperty>
  <owl:AnnotationProperty rdf:about="https://w3id.org/wco-dm/4.3.0#modelPathInstance">
    <rdfs:label xml:lang="en">An OIS path occurrence of the class</rdfs:label>
  </owl:AnnotationProperty>
  <owl:AnnotationProperty rdf:about="https://w3id.org/wco-dm/4.3.0#superClass">
    <rdfs:label xml:lang="en">UN/CEFACT superclass alignment recorded in the LIB</rdfs:label>
  </owl:AnnotationProperty>
  <owl:AnnotationProperty rdf:about="https://w3id.org/wco-dm/4.3.0#superClassElement">
    <rdfs:label xml:lang="en">UN/CEFACT superclass element alignment recorded in the LIB</rdfs:label>
  </owl:AnnotationProperty>
  <owl:AnnotationProperty rdf:about="https://w3id.org/wco-dm/4.3.0#usageContext">
    <rdfs:label xml:lang="en">LIB usage context flag (NONE/DOC/GOV/LOC/PAR/TRA)</rdfs:label>
  </owl:AnnotationProperty>
  <owl:AnnotationProperty rdf:about="https://w3id.org/wco-dm/4.3.0#occurrenceCount">
    <rdfs:label xml:lang="en">Number of OIS paths in which the entity occurs</rdfs:label>
  </owl:AnnotationProperty>
  <owl:AnnotationProperty rdf:about="https://w3id.org/wco-dm/4.3.0#minOccurs">
    <rdfs:label xml:lang="en">Minimum occurrence count (0; all package rows are optional)</rdfs:label>
  </owl:AnnotationProperty>
  <owl:AnnotationProperty rdf:about="https://w3id.org/wco-dm/4.3.0#maxOccurs">
    <rdfs:label xml:lang="en">Maximum occurrence count (data elements: 1; object roles vary by package)</rdfs:label>
  </owl:AnnotationProperty>
  <owl:AnnotationProperty rdf:about="https://w3id.org/wco-dm/4.3.0#roleName">
    <rdfs:label xml:lang="en">OIS containment role name</rdfs:label>
  </owl:AnnotationProperty>
  <owl:AnnotationProperty rdf:about="https://w3id.org/wco-dm/4.3.0#format">
    <rdfs:label xml:lang="en">WCO LIB format string</rdfs:label>
  </owl:AnnotationProperty>
  <owl:AnnotationProperty rdf:about="https://w3id.org/wco-dm/4.3.0#maxLength">
    <rdfs:label xml:lang="en">Maximum lexical length</rdfs:label>
  </owl:AnnotationProperty>
  <owl:AnnotationProperty rdf:about="https://w3id.org/wco-dm/4.3.0#minLength">
    <rdfs:label xml:lang="en">Minimum lexical length</rdfs:label>
  </owl:AnnotationProperty>
  <owl:AnnotationProperty rdf:about="https://w3id.org/wco-dm/4.3.0#totalDigits">
    <rdfs:label xml:lang="en">Maximum number of decimal digits</rdfs:label>
  </owl:AnnotationProperty>
  <owl:AnnotationProperty rdf:about="https://w3id.org/wco-dm/4.3.0#fractionDigits">
    <rdfs:label xml:lang="en">Number of fractional decimal digits</rdfs:label>
  </owl:AnnotationProperty>
  <owl:AnnotationProperty rdf:about="https://w3id.org/wco-dm/4.3.0#pattern">
    <rdfs:label xml:lang="en">Regular expression for the lexical form</rdfs:label>
  </owl:AnnotationProperty>
  <owl:AnnotationProperty rdf:about="https://w3id.org/wco-dm/4.3.0#coreDataType">
    <rdfs:label xml:lang="en">WCO core data type</rdfs:label>
  </owl:AnnotationProperty>
  <owl:AnnotationProperty rdf:about="https://w3id.org/wco-dm/4.3.0#codeList">
    <rdfs:label xml:lang="en">Code-list source string recorded in the LIB</rdfs:label>
  </owl:AnnotationProperty>
  <owl:AnnotationProperty rdf:about="https://w3id.org/wco-dm/4.3.0#codeListName">
    <rdfs:label xml:lang="en">Named XML code list matched unambiguously from the LIB catalogue</rdfs:label>
  </owl:AnnotationProperty>
  <owl:AnnotationProperty rdf:about="https://w3id.org/wco-dm/4.3.0#usedByClass">
    <rdfs:label xml:lang="en">Class that uses the property</rdfs:label>
  </owl:AnnotationProperty>
  <owl:AnnotationProperty rdf:about="https://w3id.org/wco-dm/4.3.0#usedByDataElement">
    <rdfs:label xml:lang="en">Data element that uses the code list</rdfs:label>
  </owl:AnnotationProperty>
  <owl:AnnotationProperty rdf:about="https://w3id.org/wco-dm/4.3.0#xmlTag">
    <rdfs:label xml:lang="en">XML element or attribute name</rdfs:label>
  </owl:AnnotationProperty>
  <owl:AnnotationProperty rdf:about="https://w3id.org/wco-dm/4.3.0#jsonTag">
    <rdfs:label xml:lang="en">JSON property name</rdfs:label>
  </owl:AnnotationProperty>
  <owl:AnnotationProperty rdf:about="https://w3id.org/wco-dm/4.3.0#attrUPI">
    <rdfs:label xml:lang="en">WCO attribute UPI (sample)</rdfs:label>
  </owl:AnnotationProperty>
  <owl:AnnotationProperty rdf:about="https://w3id.org/wco-dm/4.3.0#inferredPlacement">
    <rdfs:label xml:lang="en">Placement inferred because the class is absent from the OIS tree</rdfs:label>
  </owl:AnnotationProperty>
  <owl:AnnotationProperty rdf:about="https://w3id.org/wco-dm/4.3.0#branch">
    <rdfs:label xml:lang="en">Top-level OIS branch</rdfs:label>
  </owl:AnnotationProperty>
  <owl:AnnotationProperty rdf:about="https://w3id.org/wco-dm/4.3.0#codeListSource">
    <rdfs:label xml:lang="en">Code-list source</rdfs:label>
  </owl:AnnotationProperty>
  <owl:AnnotationProperty rdf:about="https://w3id.org/wco-dm/4.3.0#codeCount">
    <rdfs:label xml:lang="en">Number of code values published in the LIB</rdfs:label>
  </owl:AnnotationProperty>
  <owl:AnnotationProperty rdf:about="https://w3id.org/wco-dm/4.3.0#sha256">
    <rdfs:label xml:lang="en">SHA-256 checksum</rdfs:label>
  </owl:AnnotationProperty>
