    <rdfs:subPropertyOf rdf:resource="https://w3id.org/wco-dm/4.3.0#hasAttribute"/>
    <rdfs:label xml:lang="en">Warehouse type code</rdfs:label>
    <skos:definition xml:lang="en">Code specifying the role of a warehouse.</skos:definition>
    <rdfs:domain rdf:resource="https://w3id.org/wco-dm/4.3.0#C_43B"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <dcterms:identifier>L119</dcterms:identifier>
    <wco:format>an..3</wco:format>
    <wco:coreDataType>Code</wco:coreDataType>
    <wco:minOccurs rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</wco:minOccurs>
    <wco:maxOccurs rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</wco:maxOccurs>
    <wco:maxLength rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</wco:maxLength>
    <wco:codeList>UN/EDIFACT code list 3035
User code list</wco:codeList>
    <wco:xmlTag>RoleCode</wco:xmlTag>
    <wco:jsonTag>roleCode</wco:jsonTag>
    <wco:superClassElement>S005 role</wco:superClassElement>
    <wco:usedByClass rdf:resource="https://w3id.org/wco-dm/4.3.0#C_43B"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/wco-dm/4.3.0#dp_L120">
    <rdfs:subPropertyOf rdf:resource="https://w3id.org/wco-dm/4.3.0#hasAttribute"/>
    <rdfs:label xml:lang="en">Berth location name</rdfs:label>
    <skos:definition xml:lang="en">Name of the location in port where the means of transport will berth.</skos:definition>
    <rdfs:domain rdf:resource="https://w3id.org/wco-dm/4.3.0#C_74C"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <dcterms:identifier>L120</dcterms:identifier>
    <wco:format>an..256</wco:format>
    <wco:coreDataType>Text</wco:coreDataType>
    <wco:minOccurs rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</wco:minOccurs>
    <wco:maxOccurs rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</wco:maxOccurs>
    <wco:maxLength rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">256</wco:maxLength>
    <wco:xmlTag>Name</wco:xmlTag>
    <wco:jsonTag>name</wco:jsonTag>
    <wco:superClassElement>S002 name</wco:superClassElement>
    <wco:usedByClass rdf:resource="https://w3id.org/wco-dm/4.3.0#C_74C"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/wco-dm/4.3.0#dp_L121">
    <rdfs:subPropertyOf rdf:resource="https://w3id.org/wco-dm/4.3.0#hasAttribute"/>
    <rdfs:label xml:lang="en">Berth location identifier</rdfs:label>
    <skos:definition xml:lang="en">Identification of the location in port where the means of transport will berth.</skos:definition>
    <rdfs:domain rdf:resource="https://w3id.org/wco-dm/4.3.0#C_74C"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <dcterms:identifier>L121</dcterms:identifier>
    <wco:format>an..35</wco:format>
    <wco:coreDataType>Identifier</wco:coreDataType>
    <wco:minOccurs rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</wco:minOccurs>
    <wco:maxOccurs rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</wco:maxOccurs>
    <wco:maxLength rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">35</wco:maxLength>
    <wco:codeList>UN/LOCODE + User codes</wco:codeList>
    <wco:xmlTag>ID</wco:xmlTag>
    <wco:jsonTag>id</wco:jsonTag>
    <wco:superClassElement>S003 identification</wco:superClassElement>
    <wco:usedByClass rdf:resource="https://w3id.org/wco-dm/4.3.0#C_74C"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/wco-dm/4.3.0#dp_MD01">
    <rdfs:subPropertyOf rdf:resource="https://w3id.org/wco-dm/4.3.0#hasAttribute"/>
    <rdfs:label xml:lang="en">Acknowledgement request indicator</rdfs:label>
    <skos:definition xml:lang="en">Indicator requesting acknowledgement of the interchange.</skos:definition>
    <rdfs:domain rdf:resource="https://w3id.org/wco-dm/4.3.0#C_1MD"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
    <dcterms:identifier>MD01</dcterms:identifier>
    <wco:format>n1</wco:format>
    <wco:coreDataType>Indicator</wco:coreDataType>
    <wco:minOccurs rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</wco:minOccurs>
    <wco:maxOccurs rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</wco:maxOccurs>
    <wco:xmlTag>AcknowledgementRequestIndicator</wco:xmlTag>
    <wco:jsonTag>acknowledgementRequestIndicator</wco:jsonTag>
    <wco:usedByClass rdf:resource="https://w3id.org/wco-dm/4.3.0#C_1MD"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/wco-dm/4.3.0#dp_MD02">
    <rdfs:subPropertyOf rdf:resource="https://w3id.org/wco-dm/4.3.0#hasAttribute"/>
    <rdfs:label xml:lang="en">Application reference identifier</rdfs:label>
    <skos:definition xml:lang="en">Identification of the application area assigned by the sender, to which the messages in the interchange relate (e.g. the message identifier if all the messages in the interchange are of the same type).</skos:definition>
    <rdfs:domain rdf:resource="https://w3id.org/wco-dm/4.3.0#C_1MD"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <dcterms:identifier>MD02</dcterms:identifier>
    <wco:format>an..70</wco:format>
    <wco:coreDataType>Identifier</wco:coreDataType>
    <wco:minOccurs rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</wco:minOccurs>
    <wco:maxOccurs rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</wco:maxOccurs>
    <wco:maxLength rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">70</wco:maxLength>
    <wco:xmlTag>ApplicationReferenceID</wco:xmlTag>
    <wco:jsonTag>applicationReferenceId</wco:jsonTag>
    <wco:usedByClass rdf:resource="https://w3id.org/wco-dm/4.3.0#C_1MD"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/wco-dm/4.3.0#dp_MD03">
    <rdfs:subPropertyOf rdf:resource="https://w3id.org/wco-dm/4.3.0#hasAttribute"/>
    <rdfs:label xml:lang="en">Communications agreement identifier</rdfs:label>
    <skos:definition xml:lang="en">Identification of the type of agreement under which the interchange takes place by name or code.</skos:definition>
    <rdfs:domain rdf:resource="https://w3id.org/wco-dm/4.3.0#C_1MD"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <dcterms:identifier>MD03</dcterms:identifier>
    <wco:format>an..35</wco:format>
    <wco:coreDataType>Identifier</wco:coreDataType>
    <wco:minOccurs rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</wco:minOccurs>
    <wco:maxOccurs rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</wco:maxOccurs>
    <wco:maxLength rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">35</wco:maxLength>
    <wco:xmlTag>CommunicationsAgreementID</wco:xmlTag>
    <wco:jsonTag>communicationsAgreementId</wco:jsonTag>
    <wco:usedByClass rdf:resource="https://w3id.org/wco-dm/4.3.0#C_1MD"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/wco-dm/4.3.0#dp_MD04">
    <rdfs:subPropertyOf rdf:resource="https://w3id.org/wco-dm/4.3.0#hasAttribute"/>
    <rdfs:label xml:lang="en">Preparation date/time</rdfs:label>
    <skos:definition xml:lang="en">Date and time locally when an interchange or a functional group was prepared.</skos:definition>
    <rdfs:domain rdf:resource="https://w3id.org/wco-dm/4.3.0#C_1MD"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
    <dcterms:identifier>MD04</dcterms:identifier>
    <wco:format>an..35</wco:format>
    <wco:coreDataType>Date Time</wco:coreDataType>
    <wco:minOccurs rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</wco:minOccurs>
    <wco:maxOccurs rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</wco:maxOccurs>
    <wco:xmlTag>PreparationDateTime</wco:xmlTag>
    <wco:jsonTag>preparationDateTime</wco:jsonTag>
    <wco:usedByClass rdf:resource="https://w3id.org/wco-dm/4.3.0#C_1MD"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/wco-dm/4.3.0#dp_MD05">
    <rdfs:subPropertyOf rdf:resource="https://w3id.org/wco-dm/4.3.0#hasAttribute"/>
    <rdfs:label xml:lang="en">Syntax identification code</rdfs:label>
    <skos:definition xml:lang="en">Code specifying the agency controlling a syntax and syntax level used in an interchange.</skos:definition>
    <rdfs:domain rdf:resource="https://w3id.org/wco-dm/4.3.0#C_1MD"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <dcterms:identifier>MD05</dcterms:identifier>
    <wco:format>a4</wco:format>
    <wco:coreDataType>Code</wco:coreDataType>
    <wco:minOccurs rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</wco:minOccurs>
    <wco:maxOccurs rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</wco:maxOccurs>
    <wco:maxLength rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</wco:maxLength>
    <wco:minLength rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</wco:minLength>
    <wco:pattern>[A-Za-z]{4}</wco:pattern>
    <wco:codeList>UN/EDIFACT code list 0001</wco:codeList>
    <wco:codeListName>SyntaxIdentifierCode</wco:codeListName>
    <wco:xmlTag>SyntaxIdentificationCode</wco:xmlTag>
    <wco:jsonTag>syntaxIdentificationCode</wco:jsonTag>
    <wco:usedByClass rdf:resource="https://w3id.org/wco-dm/4.3.0#C_1MD"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/wco-dm/4.3.0#dp_MD06">
    <rdfs:subPropertyOf rdf:resource="https://w3id.org/wco-dm/4.3.0#hasAttribute"/>
    <rdfs:label xml:lang="en">Syntax version code</rdfs:label>
    <skos:definition xml:lang="en">Code specifying the version number of the syntax identified in the syntax identifier (e.g. 0001).</skos:definition>
    <rdfs:domain rdf:resource="https://w3id.org/wco-dm/4.3.0#C_1MD"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    <dcterms:identifier>MD06</dcterms:identifier>
    <wco:format>n1</wco:format>
    <wco:coreDataType>Code</wco:coreDataType>
    <wco:minOccurs rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</wco:minOccurs>
    <wco:maxOccurs rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</wco:maxOccurs>
    <wco:totalDigits rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</wco:totalDigits>
    <wco:fractionDigits rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</wco:fractionDigits>
    <wco:codeList>UN/EDIFACT code list 0002</wco:codeList>
    <wco:codeListName>SyntaxVersionCode</wco:codeListName>
    <wco:xmlTag>SyntaxVersionCode</wco:xmlTag>
    <wco:jsonTag>syntaxVersionCode</wco:jsonTag>
    <wco:usedByClass rdf:resource="https://w3id.org/wco-dm/4.3.0#C_1MD"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/wco-dm/4.3.0#dp_MD07">
    <rdfs:subPropertyOf rdf:resource="https://w3id.org/wco-dm/4.3.0#hasAttribute"/>
    <rdfs:label xml:lang="en">Test indicator</rdfs:label>
    <skos:definition xml:lang="en">Indicator that the interchange is a test.</skos:definition>
    <rdfs:domain rdf:resource="https://w3id.org/wco-dm/4.3.0#C_1MD"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
    <dcterms:identifier>MD07</dcterms:identifier>
    <wco:format>n1</wco:format>
    <wco:coreDataType>Indicator</wco:coreDataType>
    <wco:minOccurs rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</wco:minOccurs>
    <wco:maxOccurs rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</wco:maxOccurs>
    <wco:xmlTag>TestIndicator</wco:xmlTag>
    <wco:jsonTag>testIndicator</wco:jsonTag>
    <wco:usedByClass rdf:resource="https://w3id.org/wco-dm/4.3.0#C_1MD"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/wco-dm/4.3.0#dp_MD09">
    <rdfs:subPropertyOf rdf:resource="https://w3id.org/wco-dm/4.3.0#hasAttribute"/>
    <rdfs:label xml:lang="en">Business process context identifier</rdfs:label>
    <skos:definition xml:lang="en">Identification of the interaction between trading partners to achieve a given business objective.</skos:definition>
    <rdfs:domain rdf:resource="https://w3id.org/wco-dm/4.3.0#C_2MD"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <dcterms:identifier>MD09</dcterms:identifier>
    <wco:format>an..35</wco:format>
    <wco:coreDataType>Identifier</wco:coreDataType>
    <wco:minOccurs rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</wco:minOccurs>
    <wco:maxOccurs rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</wco:maxOccurs>
    <wco:maxLength rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">35</wco:maxLength>
    <wco:codeList>These values will be summarized and will be hierarchical where applicable. 
This list can be extended.
Default value "ALL" if no restrictions apply.</wco:codeList>
    <wco:xmlTag>BusinessProcessID</wco:xmlTag>
    <wco:jsonTag>businessProcessId</wco:jsonTag>
    <wco:usedByClass rdf:resource="https://w3id.org/wco-dm/4.3.0#C_2MD"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/wco-dm/4.3.0#dp_MD10">
    <rdfs:subPropertyOf rdf:resource="https://w3id.org/wco-dm/4.3.0#hasAttribute"/>
    <rdfs:label xml:lang="en">Product classification context identifier</rdfs:label>
    <skos:definition xml:lang="en">Identification of the goods or services concerned in the collaboration.</skos:definition>
    <rdfs:domain rdf:resource="https://w3id.org/wco-dm/4.3.0#C_2MD"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <dcterms:identifier>MD10</dcterms:identifier>
    <wco:format>an..35</wco:format>
    <wco:coreDataType>Identifier</wco:coreDataType>
    <wco:minOccurs rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</wco:minOccurs>
    <wco:maxOccurs rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</wco:maxOccurs>
    <wco:maxLength rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">35</wco:maxLength>
    <wco:codeList>Use relevant HS codes OR text.
Default value "ALL" if no restrictions apply.</wco:codeList>
    <wco:xmlTag>ProductClassificationID</wco:xmlTag>
    <wco:jsonTag>productClassificationId</wco:jsonTag>
    <wco:usedByClass rdf:resource="https://w3id.org/wco-dm/4.3.0#C_2MD"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/wco-dm/4.3.0#dp_MD11">
    <rdfs:subPropertyOf rdf:resource="https://w3id.org/wco-dm/4.3.0#hasAttribute"/>
    <rdfs:label xml:lang="en">Industry classification context identifier</rdfs:label>
    <skos:definition xml:lang="en">Identification of the relevant trading partner industries.</skos:definition>
    <rdfs:domain rdf:resource="https://w3id.org/wco-dm/4.3.0#C_2MD"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <dcterms:identifier>MD11</dcterms:identifier>
    <wco:format>an..35</wco:format>
    <wco:coreDataType>Identifier</wco:coreDataType>
    <wco:minOccurs rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</wco:minOccurs>
    <wco:maxOccurs rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</wco:maxOccurs>
    <wco:maxLength rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">35</wco:maxLength>
    <wco:codeList>UN International Standard Industrial Classification (ISIC).
Default value "ALL" if no restrictions apply.</wco:codeList>
    <wco:xmlTag>IndustryClassificationID</wco:xmlTag>
    <wco:jsonTag>industryClassificationId</wco:jsonTag>
    <wco:usedByClass rdf:resource="https://w3id.org/wco-dm/4.3.0#C_2MD"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/wco-dm/4.3.0#dp_MD12">
    <rdfs:subPropertyOf rdf:resource="https://w3id.org/wco-dm/4.3.0#hasAttribute"/>
    <rdfs:label xml:lang="en">Geopolitical context identifier</rdfs:label>
    <skos:definition xml:lang="en">Identification of where the business process is to be conducted.</skos:definition>
    <rdfs:domain rdf:resource="https://w3id.org/wco-dm/4.3.0#C_2MD"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <dcterms:identifier>MD12</dcterms:identifier>
    <wco:format>an..35</wco:format>
    <wco:coreDataType>Identifier</wco:coreDataType>
    <wco:minOccurs rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</wco:minOccurs>
    <wco:maxOccurs rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</wco:maxOccurs>
    <wco:maxLength rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">35</wco:maxLength>
    <wco:codeList>ISO 3166 including ISO 3166_1 and ISO 3166_2.
Default value "ALL" if no restrictions apply.</wco:codeList>
    <wco:xmlTag>GeopoliticalID</wco:xmlTag>
    <wco:jsonTag>geopoliticalId</wco:jsonTag>
    <wco:usedByClass rdf:resource="https://w3id.org/wco-dm/4.3.0#C_2MD"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/wco-dm/4.3.0#dp_MD13">
    <rdfs:subPropertyOf rdf:resource="https://w3id.org/wco-dm/4.3.0#hasAttribute"/>
    <rdfs:label xml:lang="en">Official constraints context identifier</rdfs:label>
    <skos:definition xml:lang="en">Identification of any legal restrictions or requirements on this business process.</skos:definition>
    <rdfs:domain rdf:resource="https://w3id.org/wco-dm/4.3.0#C_2MD"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <dcterms:identifier>MD13</dcterms:identifier>
    <wco:format>an..35</wco:format>
    <wco:coreDataType>Identifier</wco:coreDataType>
    <wco:minOccurs rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</wco:minOccurs>
    <wco:maxOccurs rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</wco:maxOccurs>
    <wco:maxLength rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">35</wco:maxLength>
    <wco:codeList>Proposed guideline: Use relevant laws, treaties OR regulations : User code list and abbreviations are allowed. 
Default value "NONE" if no restrictions apply.</wco:codeList>
    <wco:xmlTag>OfficialConstraintslID</wco:xmlTag>
    <wco:jsonTag>officialConstraintslId</wco:jsonTag>
    <wco:usedByClass rdf:resource="https://w3id.org/wco-dm/4.3.0#C_2MD"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/wco-dm/4.3.0#dp_MD14">
    <rdfs:subPropertyOf rdf:resource="https://w3id.org/wco-dm/4.3.0#hasAttribute"/>
    <rdfs:label xml:lang="en">Business process role context identifier</rdfs:label>
    <skos:definition xml:lang="en">Identification of the roles played by the trading partners. 
These can be derived from the Business Process.</skos:definition>
    <rdfs:domain rdf:resource="https://w3id.org/wco-dm/4.3.0#C_2MD"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <dcterms:identifier>MD14</dcterms:identifier>
    <wco:format>an..35</wco:format>
    <wco:coreDataType>Identifier</wco:coreDataType>
    <wco:minOccurs rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</wco:minOccurs>
    <wco:maxOccurs rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</wco:maxOccurs>
    <wco:maxLength rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">35</wco:maxLength>
    <wco:codeList>To be supplied by the producer of My IP.
Default value "ALL" if no restrictions apply. 
&lt;Examples: Broker, ImpORter, forwarder etc.</wco:codeList>
    <wco:xmlTag>BusinessProcessRoleID</wco:xmlTag>
    <wco:jsonTag>businessProcessRoleId</wco:jsonTag>
    <wco:usedByClass rdf:resource="https://w3id.org/wco-dm/4.3.0#C_2MD"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/wco-dm/4.3.0#dp_MD15">
    <rdfs:subPropertyOf rdf:resource="https://w3id.org/wco-dm/4.3.0#hasAttribute"/>
    <rdfs:label xml:lang="en">Supporting role context identifier</rdfs:label>
    <skos:definition xml:lang="en">Identification of other significant parties that will be using the data in the messages. Determine their role in the overall process.</skos:definition>
    <rdfs:domain rdf:resource="https://w3id.org/wco-dm/4.3.0#C_2MD"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <dcterms:identifier>MD15</dcterms:identifier>
    <wco:format>an..35</wco:format>
    <wco:coreDataType>Identifier</wco:coreDataType>
    <wco:minOccurs rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</wco:minOccurs>
    <wco:maxOccurs rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</wco:maxOccurs>
    <wco:maxLength rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">35</wco:maxLength>
    <wco:codeList>To be supplied by the producer of My IP.
Default value "ALL" if no restrictions apply.</wco:codeList>
    <wco:xmlTag>SupportingRoleID</wco:xmlTag>
    <wco:jsonTag>supportingRoleId</wco:jsonTag>
    <wco:usedByClass rdf:resource="https://w3id.org/wco-dm/4.3.0#C_2MD"/>
