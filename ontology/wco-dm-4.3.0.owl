    <wco:branch>999</wco:branch>
    <wco:occurrenceCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</wco:occurrenceCount>
    <wco:superClass>SC3 Location</wco:superClass>
    <wco:usageContext>X</wco:usageContext>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/wco-dm/4.3.0#C_01B">
