    <rdfs:label xml:lang="en">Trader reference identifier</rdfs:label>
    <skos:definition xml:lang="en">Identification of the number assigned by a declarant such as a trader reference or a carrier reference.</skos:definition>
    <rdfs:domain rdf:resource="https://w3id.org/wco-dm/4.3.0#C_35B"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <dcterms:identifier>009</dcterms:identifier>
    <wco:format>an..35</wco:format>
    <wco:coreDataType>Identifier</wco:coreDataType>
    <wco:minOccurs rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</wco:minOccurs>
    <wco:maxOccurs rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</wco:maxOccurs>
    <wco:maxLength rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">35</wco:maxLength>
    <wco:xmlTag>TraderAssignedReferenceID</wco:xmlTag>
    <wco:jsonTag>traderAssignedReferenceId</wco:jsonTag>
    <wco:usedByClass rdf:resource="https://w3id.org/wco-dm/4.3.0#C_35B"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/wco-dm/4.3.0#dp_010">
    <rdfs:subPropertyOf rdf:resource="https://w3id.org/wco-dm/4.3.0#hasAttribute"/>
    <rdfs:label xml:lang="en">Stay reference identifier</rdfs:label>
    <skos:definition xml:lang="en">Identification of the stay of a means of transport in a port or airport or other place of service.</skos:definition>
    <rdfs:domain rdf:resource="https://w3id.org/wco-dm/4.3.0#C_15A"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <dcterms:identifier>010</dcterms:identifier>
    <wco:format>an..35</wco:format>
    <wco:coreDataType>Identifier</wco:coreDataType>
    <wco:minOccurs rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</wco:minOccurs>
