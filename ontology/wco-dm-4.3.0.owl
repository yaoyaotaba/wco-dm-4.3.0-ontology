    <rdfs:subPropertyOf rdf:resource="https://w3id.org/wco-dm/4.3.0#hasAttribute"/>
    <rdfs:label xml:lang="en">Consolidation indicator</rdfs:label>
    <skos:definition xml:lang="en">Indicator of the cargo shipping method in which a freight forwarder at the place/port of origin combines several individual consignments to make up a full load.</skos:definition>
    <rdfs:domain>
      <owl:Class>
        <owl:unionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="https://w3id.org/wco-dm/4.3.0#C_21C"/>
        <rdf:Description rdf:about="https://w3id.org/wco-dm/4.3.0#C_28A"/>
        </owl:unionOf>
      </owl:Class>
    </rdfs:domain>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
    <dcterms:identifier>523</dcterms:identifier>
    <wco:format>an1</wco:format>
    <wco:coreDataType>Indicator</wco:coreDataType>
