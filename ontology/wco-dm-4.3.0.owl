    <skos:prefLabel xml:lang="zh">附加单据</skos:prefLabel>
    <skos:definition xml:lang="en">Details related to additional documents as part of a declaration or as part of a response.</skos:definition>
    <dcterms:identifier>02A</dcterms:identifier>
    <wco:classID>02A</wco:classID>
