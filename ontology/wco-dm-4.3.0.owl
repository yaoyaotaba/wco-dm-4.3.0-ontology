  <skos:ConceptScheme rdf:about="https://w3id.org/wco-dm/4.3.0#CL_TransactionNatureTypeCode">
    <skos:prefLabel xml:lang="en">TransactionNatureTypeCode</skos:prefLabel>
    <dcterms:identifier>TransactionNatureTypeCode</dcterms:identifier>
    <dcterms:source>WCO code list/TransactionNatureTypeCode (n1) + User code (n1)
Remark:
* First digit indicates WCO code table value;
* Second digit can be used as additional user code to further define first digit</dcterms:source>
    <wco:codeListSource>WCO code list/TransactionNatureTypeCode (n1) + User code (n1)
Remark:
* First digit indicates WCO code table value;
* Second digit can be used as additional user code to further define first digit</wco:codeListSource>
    <wco:codeCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">9</wco:codeCount>
    <wco:usedByDataElement rdf:resource="https://w3id.org/wco-dm/4.3.0#dp_103"/>
  </skos:ConceptScheme>
  <skos:Concept rdf:about="https://w3id.org/wco-dm/4.3.0#CV_TransactionNatureTypeCode_1">
    <skos:inScheme rdf:resource="https://w3id.org/wco-dm/4.3.0#CL_TransactionNatureTypeCode"/>
    <skos:notation>1</skos:notation>
    <skos:prefLabel xml:lang="en">1</skos:prefLabel>
    <skos:definition xml:lang="en">Transactions involving actual or intended transfer of ownership from residents to non-residents against financial or other compensation (except the transactions listed under 2, 7, 8)</skos:definition>
  </skos:Concept>
  <skos:Concept rdf:about="https://w3id.org/wco-dm/4.3.0#CV_TransactionNatureTypeCode_2">
    <skos:inScheme rdf:resource="https://w3id.org/wco-dm/4.3.0#CL_TransactionNatureTypeCode"/>
    <skos:notation>2</skos:notation>
    <skos:prefLabel xml:lang="en">2</skos:prefLabel>
    <skos:definition xml:lang="en">Return and replacement of goods free of charge after registration of the original transaction</skos:definition>
  </skos:Concept>
  <skos:Concept rdf:about="https://w3id.org/wco-dm/4.3.0#CV_TransactionNatureTypeCode_3">
    <skos:inScheme rdf:resource="https://w3id.org/wco-dm/4.3.0#CL_TransactionNatureTypeCode"/>
    <skos:notation>3</skos:notation>
    <skos:prefLabel xml:lang="en">3</skos:prefLabel>
    <skos:definition xml:lang="en">Transactions involving transfer of ownership without financial or in-kind compensation (e.g. aid shipments)</skos:definition>
  </skos:Concept>
  <skos:Concept rdf:about="https://w3id.org/wco-dm/4.3.0#CV_TransactionNatureTypeCode_4">
    <skos:inScheme rdf:resource="https://w3id.org/wco-dm/4.3.0#CL_TransactionNatureTypeCode"/>
    <skos:notation>4</skos:notation>
    <skos:prefLabel xml:lang="en">4</skos:prefLabel>
    <skos:definition xml:lang="en">Operations with a view to processing (2) under contract (no transfer of ownership to the processor)</skos:definition>
  </skos:Concept>
  <skos:Concept rdf:about="https://w3id.org/wco-dm/4.3.0#CV_TransactionNatureTypeCode_5">
    <skos:inScheme rdf:resource="https://w3id.org/wco-dm/4.3.0#CL_TransactionNatureTypeCode"/>
    <skos:notation>5</skos:notation>
    <skos:prefLabel xml:lang="en">5</skos:prefLabel>
    <skos:definition xml:lang="en">Operations following processing under contract (no transfer of ownership to the processor)</skos:definition>
  </skos:Concept>
  <skos:Concept rdf:about="https://w3id.org/wco-dm/4.3.0#CV_TransactionNatureTypeCode_6">
    <skos:inScheme rdf:resource="https://w3id.org/wco-dm/4.3.0#CL_TransactionNatureTypeCode"/>
    <skos:notation>6</skos:notation>
    <skos:prefLabel xml:lang="en">6</skos:prefLabel>
    <skos:definition xml:lang="en">Particular transactions recorded for national purposes</skos:definition>
  </skos:Concept>
  <skos:Concept rdf:about="https://w3id.org/wco-dm/4.3.0#CV_TransactionNatureTypeCode_7">
    <skos:inScheme rdf:resource="https://w3id.org/wco-dm/4.3.0#CL_TransactionNatureTypeCode"/>
    <skos:notation>7</skos:notation>
    <skos:prefLabel xml:lang="en">7</skos:prefLabel>
    <skos:definition xml:lang="en">Operations under joint defence projects or other joint intergovernmental production programmes</skos:definition>
  </skos:Concept>
  <skos:Concept rdf:about="https://w3id.org/wco-dm/4.3.0#CV_TransactionNatureTypeCode_8">
    <skos:inScheme rdf:resource="https://w3id.org/wco-dm/4.3.0#CL_TransactionNatureTypeCode"/>
    <skos:notation>8</skos:notation>
    <skos:prefLabel xml:lang="en">8</skos:prefLabel>
    <skos:definition xml:lang="en">Transactions involving the supply of building materials and technical equipment under a general construction or civil engineering contract for which no separate invoicing of the goods is required and an invoice for the total contract is issued</skos:definition>
  </skos:Concept>
  <skos:Concept rdf:about="https://w3id.org/wco-dm/4.3.0#CV_TransactionNatureTypeCode_9">
    <skos:inScheme rdf:resource="https://w3id.org/wco-dm/4.3.0#CL_TransactionNatureTypeCode"/>
    <skos:notation>9</skos:notation>
    <skos:prefLabel xml:lang="en">9</skos:prefLabel>
    <skos:definition xml:lang="en">Other transactions which cannot be classified under other codes</skos:definition>
  </skos:Concept>
  <skos:ConceptScheme rdf:about="https://w3id.org/wco-dm/4.3.0#CL_TransitPassengerIndicatorCode">
    <skos:prefLabel xml:lang="en">TransitPassengerIndicatorCode</skos:prefLabel>
