    <rdfs:label xml:lang="en">Effects description code</rdfs:label>
    <skos:definition xml:lang="en">Code specifying the type of personal belongings in the possession of individual crew members or passengers, which according to regulations in force at the place of arrival of a means of transport, are dutiable or subject to prohibitions or restrictions.</skos:definition>
    <rdfs:domain rdf:resource="https://w3id.org/wco-dm/4.3.0#C_65B"/>
