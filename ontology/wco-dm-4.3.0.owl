    <wco:jsonTag>typeCode</wco:jsonTag>
    <wco:usedByClass rdf:resource="https://w3id.org/wco-dm/4.3.0#C_50A"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/wco-dm/4.3.0#dp_114">
