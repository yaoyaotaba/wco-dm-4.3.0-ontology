  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/wco-dm/4.3.0#dp_011">
    <rdfs:subPropertyOf rdf:resource="https://w3id.org/wco-dm/4.3.0#hasAttribute"/>
    <rdfs:label xml:lang="en">Carrier split consignment code</rdfs:label>
    <skos:definition xml:lang="en">Code specifying split consignment for each load assigned by a carrier.</skos:definition>
    <rdfs:domain rdf:resource="https://w3id.org/wco-dm/4.3.0#C_28A"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <dcterms:identifier>011</dcterms:identifier>
    <wco:format>an..3</wco:format>
    <wco:coreDataType>Code</wco:coreDataType>
    <wco:minOccurs rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</wco:minOccurs>
    <wco:maxOccurs rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</wco:maxOccurs>
    <wco:maxLength rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</wco:maxLength>
    <wco:codeList>UN/EDIFACT code list 7365 subset (codes 156 and 157)</wco:codeList>
    <wco:codeListName>CarrierSplitConsignmentCode</wco:codeListName>
    <wco:xmlTag>TransportSplitCode</wco:xmlTag>
    <wco:jsonTag>transportSplitCode</wco:jsonTag>
    <wco:usedByClass rdf:resource="https://w3id.org/wco-dm/4.3.0#C_28A"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/wco-dm/4.3.0#dp_013">
    <rdfs:subPropertyOf rdf:resource="https://w3id.org/wco-dm/4.3.0#hasAttribute"/>
    <rdfs:label xml:lang="en">Number of loading lists</rdfs:label>
    <skos:definition xml:lang="en">Quantity specifying the number of loading lists, manifests or similar documents.</skos:definition>
    <rdfs:domain>
      <owl:Class>
        <owl:unionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="https://w3id.org/wco-dm/4.3.0#C_42A"/>
        <rdf:Description rdf:about="https://w3id.org/wco-dm/4.3.0#C_74B"/>
        <rdf:Description rdf:about="https://w3id.org/wco-dm/4.3.0#C_999"/>
        </owl:unionOf>
      </owl:Class>
    </rdfs:domain>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    <dcterms:identifier>013</dcterms:identifier>
    <wco:format>n..5</wco:format>
    <wco:coreDataType>Quantity</wco:coreDataType>
    <wco:minOccurs rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</wco:minOccurs>
    <wco:maxOccurs rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</wco:maxOccurs>
    <wco:totalDigits rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</wco:totalDigits>
    <wco:fractionDigits rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</wco:fractionDigits>
    <wco:xmlTag>LoadingListQuantity</wco:xmlTag>
    <wco:jsonTag>loadingListQuantity</wco:jsonTag>
    <wco:usedByClass rdf:resource="https://w3id.org/wco-dm/4.3.0#C_42A"/>
    <wco:usedByClass rdf:resource="https://w3id.org/wco-dm/4.3.0#C_74B"/>
    <wco:usedByClass rdf:resource="https://w3id.org/wco-dm/4.3.0#C_999"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/wco-dm/4.3.0#dp_014">
    <rdfs:subPropertyOf rdf:resource="https://w3id.org/wco-dm/4.3.0#hasAttribute"/>
    <rdfs:label xml:lang="en">Payment identifier</rdfs:label>
    <skos:definition xml:lang="en">Identification of the payment of a duty or tax by reference number.</skos:definition>
    <rdfs:domain rdf:resource="https://w3id.org/wco-dm/4.3.0#C_94A"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <dcterms:identifier>014</dcterms:identifier>
    <wco:format>an..35</wco:format>
    <wco:coreDataType>Identifier</wco:coreDataType>
    <wco:minOccurs rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</wco:minOccurs>
    <wco:maxOccurs rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</wco:maxOccurs>
    <wco:maxLength rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">35</wco:maxLength>
    <wco:xmlTag>ReferenceID</wco:xmlTag>
    <wco:jsonTag>referenceId</wco:jsonTag>
    <wco:usedByClass rdf:resource="https://w3id.org/wco-dm/4.3.0#C_94A"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/wco-dm/4.3.0#dp_016">
    <rdfs:subPropertyOf rdf:resource="https://w3id.org/wco-dm/4.3.0#hasAttribute"/>
    <rdfs:label xml:lang="en">UCR identifier</rdfs:label>
    <skos:definition xml:lang="en">Identification of the unique number assigned to goods being subject to cross border transactions.</skos:definition>
    <rdfs:domain rdf:resource="https://w3id.org/wco-dm/4.3.0#C_35B"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <dcterms:identifier>016</dcterms:identifier>
    <wco:format>an..35</wco:format>
    <wco:coreDataType>Identifier</wco:coreDataType>
    <wco:minOccurs rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</wco:minOccurs>
    <wco:maxOccurs rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</wco:maxOccurs>
    <wco:maxLength rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">35</wco:maxLength>
    <wco:codeList>ISO 15459 OR equivalent</wco:codeList>
    <wco:xmlTag>ID</wco:xmlTag>
    <wco:jsonTag>id</wco:jsonTag>
    <wco:usedByClass rdf:resource="https://w3id.org/wco-dm/4.3.0#C_35B"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/wco-dm/4.3.0#dp_024">
    <rdfs:subPropertyOf rdf:resource="https://w3id.org/wco-dm/4.3.0#hasAttribute"/>
    <rdfs:label xml:lang="en">Exit date/time</rdfs:label>
    <skos:definition xml:lang="en">Date and time when the goods depart from last port, airport, or border post of customs territory whence consigned (country of export).</skos:definition>
    <rdfs:domain rdf:resource="https://w3id.org/wco-dm/4.3.0#C_67A"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
    <dcterms:identifier>024</dcterms:identifier>
    <wco:format>an..35</wco:format>
    <wco:coreDataType>Date Time</wco:coreDataType>
    <wco:minOccurs rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</wco:minOccurs>
    <wco:maxOccurs rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</wco:maxOccurs>
    <wco:xmlTag>ExitDateTime</wco:xmlTag>
    <wco:jsonTag>exitDateTime</wco:jsonTag>
    <wco:usedByClass rdf:resource="https://w3id.org/wco-dm/4.3.0#C_67A"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/wco-dm/4.3.0#dp_025">
    <rdfs:subPropertyOf rdf:resource="https://w3id.org/wco-dm/4.3.0#hasAttribute"/>
    <rdfs:label xml:lang="en">Vanning date/time</rdfs:label>
    <skos:definition xml:lang="en">Date and time of loading cargo into a container.</skos:definition>
    <rdfs:domain rdf:resource="https://w3id.org/wco-dm/4.3.0#C_16B"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
    <dcterms:identifier>025</dcterms:identifier>
    <wco:format>an..35</wco:format>
    <wco:coreDataType>Date Time</wco:coreDataType>
    <wco:minOccurs rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</wco:minOccurs>
    <wco:maxOccurs rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</wco:maxOccurs>
    <wco:xmlTag>StuffingDateTime</wco:xmlTag>
    <wco:jsonTag>stuffingDateTime</wco:jsonTag>
    <wco:usedByClass rdf:resource="https://w3id.org/wco-dm/4.3.0#C_16B"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/wco-dm/4.3.0#dp_027">
    <rdfs:subPropertyOf rdf:resource="https://w3id.org/wco-dm/4.3.0#hasAttribute"/>
    <rdfs:label xml:lang="en">Transit control days quantity</rdfs:label>
    <skos:definition xml:lang="en">Quantity specifying the number of days a consignment is under transit control.</skos:definition>
    <rdfs:domain rdf:resource="https://w3id.org/wco-dm/4.3.0#C_24B"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    <dcterms:identifier>027</dcterms:identifier>
    <wco:format>n..2</wco:format>
    <wco:coreDataType>Quantity</wco:coreDataType>
    <wco:minOccurs rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</wco:minOccurs>
    <wco:maxOccurs rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</wco:maxOccurs>
    <wco:totalDigits rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</wco:totalDigits>
    <wco:fractionDigits rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</wco:fractionDigits>
    <wco:xmlTag>DurationInDaysQuantity</wco:xmlTag>
    <wco:jsonTag>durationInDaysQuantity</wco:jsonTag>
    <wco:usedByClass rdf:resource="https://w3id.org/wco-dm/4.3.0#C_24B"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/wco-dm/4.3.0#dp_029">
    <rdfs:subPropertyOf rdf:resource="https://w3id.org/wco-dm/4.3.0#hasAttribute"/>
    <rdfs:label xml:lang="en">Consignment unloading date/time</rdfs:label>
    <skos:definition xml:lang="en">Date and time the cargo was outturned.</skos:definition>
    <rdfs:domain rdf:resource="https://w3id.org/wco-dm/4.3.0#C_15A"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
    <dcterms:identifier>029</dcterms:identifier>
    <wco:format>an..35</wco:format>
    <wco:coreDataType>Date Time</wco:coreDataType>
    <wco:minOccurs rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</wco:minOccurs>
    <wco:maxOccurs rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</wco:maxOccurs>
    <wco:xmlTag>DischargeCompletedDateTime</wco:xmlTag>
    <wco:jsonTag>dischargeCompletedDateTime</wco:jsonTag>
    <wco:usedByClass rdf:resource="https://w3id.org/wco-dm/4.3.0#C_15A"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/wco-dm/4.3.0#dp_030">
    <rdfs:subPropertyOf rdf:resource="https://w3id.org/wco-dm/4.3.0#hasAttribute"/>
    <rdfs:label xml:lang="en">Departure date/time</rdfs:label>
    <skos:definition xml:lang="en">Date and time of the departure of the goods from original consignor.</skos:definition>
    <rdfs:domain rdf:resource="https://w3id.org/wco-dm/4.3.0#C_67A"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
    <dcterms:identifier>030</dcterms:identifier>
    <wco:format>an..35</wco:format>
    <wco:coreDataType>Date Time</wco:coreDataType>
    <wco:minOccurs rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</wco:minOccurs>
    <wco:maxOccurs rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</wco:maxOccurs>
    <wco:xmlTag>DispatchDateTime</wco:xmlTag>
    <wco:jsonTag>dispatchDateTime</wco:jsonTag>
    <wco:usedByClass rdf:resource="https://w3id.org/wco-dm/4.3.0#C_67A"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/wco-dm/4.3.0#dp_031">
    <rdfs:subPropertyOf rdf:resource="https://w3id.org/wco-dm/4.3.0#hasAttribute"/>
    <rdfs:label xml:lang="en">Consignment loading date/time</rdfs:label>
    <skos:definition xml:lang="en">Date and time of initial loading onto a ship or airplane during one journey from export location to import location.</skos:definition>
    <rdfs:domain rdf:resource="https://w3id.org/wco-dm/4.3.0#C_83A"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
    <dcterms:identifier>031</dcterms:identifier>
    <wco:format>an..35</wco:format>
    <wco:coreDataType>Date Time</wco:coreDataType>
    <wco:minOccurs rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</wco:minOccurs>
    <wco:maxOccurs rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</wco:maxOccurs>
    <wco:xmlTag>LoadingDateTime</wco:xmlTag>
    <wco:jsonTag>loadingDateTime</wco:jsonTag>
    <wco:usedByClass rdf:resource="https://w3id.org/wco-dm/4.3.0#C_83A"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/wco-dm/4.3.0#dp_062">
    <rdfs:subPropertyOf rdf:resource="https://w3id.org/wco-dm/4.3.0#hasAttribute"/>
    <rdfs:label xml:lang="en">Country of exportation code</rdfs:label>
    <skos:definition xml:lang="en">Code specifying the country from which the goods are originally exported without any commercial transaction taken place in intermediate countries.</skos:definition>
    <rdfs:domain rdf:resource="https://w3id.org/wco-dm/4.3.0#C_95B"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <dcterms:identifier>062</dcterms:identifier>
    <wco:format>a2</wco:format>
    <wco:coreDataType>Code</wco:coreDataType>
    <wco:minOccurs rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</wco:minOccurs>
    <wco:maxOccurs rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</wco:maxOccurs>
    <wco:maxLength rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</wco:maxLength>
    <wco:minLength rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</wco:minLength>
    <wco:pattern>[A-Za-z]{2}</wco:pattern>
    <wco:codeList>ISO 3166-1</wco:codeList>
    <wco:codeListName>CountryCode</wco:codeListName>
    <wco:xmlTag>CountryCode</wco:xmlTag>
    <wco:jsonTag>countryCode</wco:jsonTag>
    <wco:usedByClass rdf:resource="https://w3id.org/wco-dm/4.3.0#C_95B"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/wco-dm/4.3.0#dp_063">
    <rdfs:subPropertyOf rdf:resource="https://w3id.org/wco-dm/4.3.0#hasAttribute"/>
    <rdfs:label xml:lang="en">Country of origin code</rdfs:label>
    <skos:definition xml:lang="en">Code specifying the country in which the goods have been produced or manufactured, according to criteria laid down for the application of the Customs tariff or quantitative restrictions, or any measure related to trade.</skos:definition>
    <rdfs:domain rdf:resource="https://w3id.org/wco-dm/4.3.0#C_92A"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <dcterms:identifier>063</dcterms:identifier>
    <wco:format>a2</wco:format>
    <wco:coreDataType>Code</wco:coreDataType>
    <wco:minOccurs rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</wco:minOccurs>
    <wco:maxOccurs rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</wco:maxOccurs>
    <wco:maxLength rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</wco:maxLength>
    <wco:minLength rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</wco:minLength>
    <wco:pattern>[A-Za-z]{2}</wco:pattern>
    <wco:codeList>ISO 3166-1</wco:codeList>
    <wco:codeListName>CountryCode</wco:codeListName>
    <wco:xmlTag>CountryCode</wco:xmlTag>
    <wco:jsonTag>countryCode</wco:jsonTag>
    <wco:usedByClass rdf:resource="https://w3id.org/wco-dm/4.3.0#C_92A"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/wco-dm/4.3.0#dp_064">
    <rdfs:subPropertyOf rdf:resource="https://w3id.org/wco-dm/4.3.0#hasAttribute"/>
    <rdfs:label xml:lang="en">Country of routing code</rdfs:label>
    <skos:definition xml:lang="en">Code specifying the country through which goods or passengers are routed between the country of original departure and final destination.</skos:definition>
    <rdfs:domain rdf:resource="https://w3id.org/wco-dm/4.3.0#C_81A"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <dcterms:identifier>064</dcterms:identifier>
    <wco:format>a2</wco:format>
    <wco:coreDataType>Code</wco:coreDataType>
    <wco:minOccurs rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</wco:minOccurs>
    <wco:maxOccurs rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</wco:maxOccurs>
    <wco:maxLength rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</wco:maxLength>
    <wco:minLength rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</wco:minLength>
    <wco:pattern>[A-Za-z]{2}</wco:pattern>
    <wco:codeList>ISO 3166-1</wco:codeList>
    <wco:codeListName>CountryCode</wco:codeListName>
    <wco:xmlTag>RoutingCountryCode</wco:xmlTag>
    <wco:jsonTag>routingCountryCode</wco:jsonTag>
    <wco:usedByClass rdf:resource="https://w3id.org/wco-dm/4.3.0#C_81A"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/wco-dm/4.3.0#dp_066">
    <rdfs:subPropertyOf rdf:resource="https://w3id.org/wco-dm/4.3.0#hasAttribute"/>
    <rdfs:label xml:lang="en">Region of origin identifier</rdfs:label>
    <skos:definition xml:lang="en">Identification of the region in which the goods have been produced or manufactured, according to criteria laid down for the purposes of application of the Customs tariff, or quantitative restrictions, or of any other measure related to trade.</skos:definition>
    <rdfs:domain rdf:resource="https://w3id.org/wco-dm/4.3.0#C_92A"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <dcterms:identifier>066</dcterms:identifier>
    <wco:format>an..9</wco:format>
    <wco:coreDataType>Identifier</wco:coreDataType>
    <wco:minOccurs rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</wco:minOccurs>
    <wco:maxOccurs rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</wco:maxOccurs>
    <wco:maxLength rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">9</wco:maxLength>
    <wco:xmlTag>RegionID</wco:xmlTag>
    <wco:jsonTag>regionId</wco:jsonTag>
    <wco:usedByClass rdf:resource="https://w3id.org/wco-dm/4.3.0#C_92A"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/wco-dm/4.3.0#dp_088">
    <rdfs:subPropertyOf rdf:resource="https://w3id.org/wco-dm/4.3.0#hasAttribute"/>
    <rdfs:label xml:lang="en">Region of export identifier</rdfs:label>
    <skos:definition xml:lang="en">Identification of country subdivision where goods begin their journey to export location.</skos:definition>
