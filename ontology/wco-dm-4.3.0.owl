    <dcterms:identifier>115</dcterms:identifier>
    <wco:format>n..17,3</wco:format>
    <wco:coreDataType>Numeric</wco:coreDataType>
    <wco:minOccurs rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</wco:minOccurs>
    <wco:maxOccurs rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</wco:maxOccurs>
    <wco:totalDigits rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">17</wco:totalDigits>
    <wco:fractionDigits rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</wco:fractionDigits>
