wco:Shape_C_2MD a sh:NodeShape ;
  sh:targetClass wco:C_2MD ;
  sh:name "ContextMetaData"@en ;
  sh:description "Details related to meta data to be used related to the context."@en ;
  sh:closed false ;
  sh:property [
    a sh:PropertyShape ;
    sh:path wco:dp_MD09 ;
    sh:name "Business process context identifier"@en ;
    sh:description "Identification of the interaction between trading partners to achieve a given business objective."@en ;
    sh:datatype xsd:string ;
    sh:maxCount 1 ;
    sh:maxLength 35 ;
