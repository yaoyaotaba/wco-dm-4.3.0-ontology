wco:Shape_C_23B a sh:NodeShape ;
  sh:targetClass wco:C_23B ;
  sh:name "TranshipmentLocation"@en ;
  sh:description "Details related to the location where goods are to be transferred from one means of transport to another during the course of one transport."@en ;
