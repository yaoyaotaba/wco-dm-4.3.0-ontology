    sh:maxCount 1 ;
    sh:maxLength 35 ;
    sh:order 23 ;
  ] ;
  sh:property [
    a sh:PropertyShape ;
    sh:path wco:dp_MD12 ;
    sh:name "Geopolitical context identifier"@en ;
    sh:description "Identification of where the business process is to be conducted."@en ;
    sh:datatype xsd:string ;
    sh:maxCount 1 ;
    sh:maxLength 35 ;
    sh:order 24 ;
  ] ;
  sh:property [
    a sh:PropertyShape ;
    sh:path wco:dp_MD13 ;
    sh:name "Official constraints context identifier"@en ;
    sh:description "Identification of any legal restrictions or requirements on this business process."@en ;
    sh:datatype xsd:string ;
    sh:maxCount 1 ;
    sh:maxLength 35 ;
    sh:order 25 ;
  ] ;
  sh:property [
    a sh:PropertyShape ;
    sh:path wco:dp_MD14 ;
    sh:name "Business process role context identifier"@en ;
    sh:description "Identification of the roles played by the trading partners. \nThese can be derived from the Business Process."@en ;
    sh:datatype xsd:string ;
    sh:maxCount 1 ;
    sh:maxLength 35 ;
    sh:order 26 ;
  ] ;
  sh:property [
    a sh:PropertyShape ;
    sh:path wco:dp_MD15 ;
    sh:name "Supporting role context identifier"@en ;
    sh:description "Identification of other significant parties that will be using the data in the messages. Determine their role in the overall process."@en ;
    sh:datatype xsd:string ;
    sh:maxCount 1 ;
    sh:maxLength 35 ;
    sh:order 27 ;
  ] ;
  sh:property [
    a sh:PropertyShape ;
    sh:path wco:dp_MD16 ;
    sh:name "System capabilities context identifier"@en ;
    sh:description "Identification of major restrictions derived from system, a class of systems or standard in the business situation. Identify the type of system."@en ;
    sh:datatype xsd:string ;
    sh:maxCount 1 ;
    sh:maxLength 35 ;
    sh:order 28 ;
  ] .

