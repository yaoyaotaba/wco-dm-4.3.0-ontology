    sh:description "Code specifying the level of packaging (e.g. inner, intermediate, outer, shipment level)."@en ;
    sh:datatype xsd:string ;
    sh:maxCount 1 ;
    sh:maxLength 3 ;
    sh:order 1034 ;
  ] ;
  sh:property [
    a sh:PropertyShape ;
