wco:Shape_C_22A a sh:NodeShape ;
  sh:targetClass wco:C_22A ;
  sh:name "CommercialDriversLicense"@en ;
  sh:description "Details related to the license issued by appropriate authority allowing a driver to operate a commercial (i.e., non-private) vehicle for transporting people or commercial cargo."@en ;
  sh:closed false ;
  sh:property [
    a sh:PropertyShape ;
    sh:path wco:dp_296 ;
    sh:name "Commercial driver's license country code"@en ;
    sh:description "Code specifying the country or political entity issuing the commercial driver's license."@en ;
    sh:datatype xsd:string ;
    sh:maxCount 1 ;
    sh:maxLength 2 ;
    sh:minLength 2 ;
    sh:pattern "^[A-Za-z]{2}$" ;
    sh:order 1004 ;
  ] ;
  sh:property [
    a sh:PropertyShape ;
    sh:path wco:dp_297 ;
    sh:name "Commercial driver's license state, province, or country subdivision code"@en ;
    sh:description "Code specifying the state, province, or country subdivision issuing the commercial driver's license."@en ;
    sh:datatype xsd:string ;
    sh:maxCount 1 ;
    sh:maxLength 9 ;
    sh:order 1005 ;
  ] ;
  sh:property [
    a sh:PropertyShape ;
    sh:path wco:dp_359 ;
    sh:name "Commercial driver's license endorsement code"@en ;
    sh:description "Code specifying the type of special service authorization present on the commercial driver’s license."@en ;
    sh:datatype xsd:string ;
    sh:maxCount 1 ;
    sh:maxLength 3 ;
    sh:order 1006 ;
  ] .

wco:Shape_C_22B a sh:NodeShape ;
  sh:targetClass wco:C_22B ;
  sh:name "TradeTerms"@en ;
  sh:description "Details related to trade terms."@en ;
  sh:closed false ;
  sh:property [
    a sh:PropertyShape ;
    sh:path wco:dp_090 ;
    sh:name "Incoterms code"@en ;
    sh:description "Code specifying the delivery or transport terms."@en ;
    sh:datatype xsd:string ;
    sh:maxCount 1 ;
    sh:maxLength 3 ;
    sh:minLength 3 ;
    sh:pattern "^[A-Za-z]{3}$" ;
    sh:order 1381 ;
  ] ;
  sh:property [
    a sh:PropertyShape ;
    sh:path wco:dp_106 ;
    sh:name "Country relationship code"@en ;
    sh:description "Code specifying whether the place specified for the performance of a (contractual) obligation is located in the country where the declaration is made, in another member country of the same economic or Customs union, or in a third country."@en ;
    sh:datatype xsd:string ;
    sh:maxCount 1 ;
    sh:maxLength 3 ;
    sh:order 1382 ;
  ] ;
  sh:property [
    a sh:PropertyShape ;
    sh:path wco:dp_089 ;
    sh:name "Incoterms description"@en ;
    sh:description "Description of delivery or transport terms."@en ;
    sh:datatype xsd:string ;
    sh:maxCount 1 ;
    sh:maxLength 70 ;
    sh:order 1383 ;
  ] ;
  sh:property [
    a sh:PropertyShape ;
    sh:path wco:dp_543 ;
    sh:name "Incoterms location identifier"@en ;
    sh:description "Identification of the location or port of departure, shipment or destination, as required under the applicable delivery term."@en ;
    sh:datatype xsd:string ;
    sh:maxCount 1 ;
    sh:maxLength 17 ;
    sh:order 1384 ;
  ] ;
  sh:property [
    a sh:PropertyShape ;
    sh:path wco:dp_542 ;
    sh:name "Incoterms location name"@en ;
    sh:description "Name of the location or port of departure, shipment or destination, as required under the applicable terms of delivery (i.e., Incoterms)."@en ;
    sh:datatype xsd:string ;
    sh:maxCount 1 ;
    sh:maxLength 256 ;
    sh:order 1385 ;
  ] ;
  sh:property [
    a sh:PropertyShape ;
    sh:path wco:dp_545 ;
    sh:name "Incoterms country code"@en ;
    sh:description "Code specifying the country code to cover the cases when UNLOCODE is not available to define a delivery terms location in IM/EX declarations."@en ;
    sh:datatype xsd:string ;
    sh:maxCount 1 ;
    sh:maxLength 2 ;
    sh:minLength 2 ;
    sh:pattern "^[A-Za-z]{2}$" ;
    sh:order 1386 ;
  ] .

