    sh:name "Packaging certification indicator"@en ;
    sh:description "Indicator that the packaging has the proper certification regarding weight, capacity and usage."@en ;
    sh:datatype xsd:boolean ;
    sh:maxCount 1 ;
    sh:order 1035 ;
  ] ;
  sh:property [
    a sh:PropertyShape ;
    sh:path wco:dp_343 ;
