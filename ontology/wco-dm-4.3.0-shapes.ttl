@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .

wco:Shapes a owl:Ontology ;
  rdfs:label "WCO DM 4.3.0 SHACL shapes"@en ;
  dcterms:source <https://datamodel.wcoomd.org/#/package> .

wco:Shape_C_OIS a sh:NodeShape ;
  sh:targetClass wco:C_OIS ;
  sh:name "OIS"@en ;
  sh:name "总体信息结构"@zh ;
  sh:description "Overall Information Structure (OIS): the root container of the WCO Data Model 4.3.0 class hierarchy, comprising the MDIP metadata package and the Content Information Structure (CIS)."@en ;
  sh:closed false ;
  sh:property [
    a sh:PropertyShape ;
    sh:path wco:hasAIP ;
    sh:name "has AIP"@en ;
    sh:description "Associates a containing WCO DM class with its AIP component (AIP)."@en ;
    sh:class wco:C_58C ;
    sh:nodeKind sh:IRI ;
  ] ;
  sh:property [
    a sh:PropertyShape ;
    sh:path wco:hasCIS ;
    sh:name "has CIS"@en ;
    sh:description "Associates a containing WCO DM class with its CIS component (ContentInformationStructure)."@en ;
    sh:class wco:C_999 ;
    sh:nodeKind sh:IRI ;
  ] ;
  sh:property [
    a sh:PropertyShape ;
    sh:path wco:hasDeclaration ;
    sh:name "has declaration"@en ;
    sh:description "Associates a containing WCO DM class with its declaration component (Declaration)."@en ;
    sh:class wco:C_42A ;
    sh:nodeKind sh:IRI ;
  ] ;
  sh:property [
    a sh:PropertyShape ;
    sh:path wco:hasLPCO ;
    sh:name "has LPCO"@en ;
    sh:description "Associates a containing WCO DM class with its LPCO component (LPCO)."@en ;
    sh:class wco:C_74B ;
    sh:nodeKind sh:IRI ;
  ] ;
  sh:property [
    a sh:PropertyShape ;
    sh:path wco:hasMDIP ;
    sh:name "has MDIP"@en ;
    sh:description "Associates a containing WCO DM class with its MDIP component (MDIP)."@en ;
    sh:class wco:C_3MD ;
    sh:nodeKind sh:IRI ;
  ] .

wco:Shape_C_01A a sh:NodeShape ;
  sh:targetClass wco:C_01A ;
  sh:name "AcceptanceLocation"@en ;
  sh:description "Details related to the location of acceptance."@en ;
  sh:closed false ;
  sh:property [
    a sh:PropertyShape ;
    sh:path wco:dp_L011 ;
    sh:name "Acceptance location name"@en ;
    sh:description "Name of the location where the goods are taken over by the carrier from the consignor."@en ;
    sh:datatype xsd:string ;
    sh:maxCount 1 ;
    sh:maxLength 256 ;
    sh:order 89 ;
  ] ;
  sh:property [
    a sh:PropertyShape ;
    sh:path wco:dp_L099 ;
    sh:name "Acceptance location identifier"@en ;
    sh:description "Identification of the location where the goods are taken over by the carrier from the consignor."@en ;
    sh:datatype xsd:string ;
    sh:maxCount 1 ;
    sh:maxLength 35 ;
    sh:order 90 ;
  ] ;
  sh:property [
    a sh:PropertyShape ;
    sh:path wco:dp_466 ;
    sh:name "Goods taking over date/time"@en ;
    sh:description "Date and time when the goods are taken over."@en ;
    sh:datatype xsd:dateTime ;
    sh:maxCount 1 ;
    sh:order 91 ;
  ] ;
  sh:property [
    a sh:PropertyShape ;
    sh:path wco:hasAddress ;
    sh:name "has address"@en ;
    sh:description "Associates a containing WCO DM class with its address component (Address)."@en ;
    sh:class wco:C_04A ;
    sh:nodeKind sh:IRI ;
  ] .

