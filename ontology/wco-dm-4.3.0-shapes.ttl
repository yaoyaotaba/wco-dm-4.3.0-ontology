    sh:description "Code specifying the type of location of transhipment."@en ;
    sh:datatype xsd:string ;
    sh:maxCount 1 ;
    sh:maxLength 3 ;
    sh:order 205 ;
  ] ;
  sh:property [
    a sh:PropertyShape ;
