wco:Shape_C_24A a sh:NodeShape ;
  sh:targetClass wco:C_24A ;
  sh:name "CommodityRelatedPackaging"@en ;
  sh:description "Details related to packaging including packing material, size, dimension, hierarchy, certification and marking."@en ;
  sh:closed false ;
  sh:property [
    a sh:PropertyShape ;
