    sh:description "Description of the method used in packing the commodity (e.g. hermetically sealed, repacked in original container)."@en ;
    sh:datatype xsd:string ;
    sh:maxCount 1 ;
    sh:maxLength 3 ;
    sh:order 1036 ;
  ] ;
  sh:property [
    a sh:PropertyShape ;
    sh:path wco:dp_345 ;
    sh:name "Package markings"@en ;
    sh:description "Description of the markings on a consumer level package."@en ;
    sh:datatype xsd:string ;
    sh:maxCount 1 ;
    sh:maxLength 512 ;
    sh:order 1037 ;
  ] ;
  sh:property [
    a sh:PropertyShape ;
    sh:path wco:dp_362 ;
    sh:name "Package filler description"@en ;
    sh:description "Description of the material found within a package used to cushion the commodity or otherwise empty space."@en ;
    sh:datatype xsd:string ;
    sh:maxCount 1 ;
    sh:maxLength 256 ;
    sh:order 1038 ;
  ] ;
  sh:property [
    a sh:PropertyShape ;
    sh:path wco:dp_366 ;
    sh:name "Package level indicator"@en ;
    sh:description "Indicator to identify if the package in an inner or outer package."@en ;
    sh:datatype xsd:boolean ;
    sh:maxCount 1 ;
    sh:order 1039 ;
  ] ;
  sh:property [
    a sh:PropertyShape ;
