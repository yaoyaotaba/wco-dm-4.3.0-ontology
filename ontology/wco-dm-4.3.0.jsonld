    {
      "@id": "wco:CL_TransactionNatureTypeCode",
      "@type": "skos:ConceptScheme",
      "skos:prefLabel": {
        "@value": "TransactionNatureTypeCode",
        "@language": "en"
      },
      "dcterms:identifier": "TransactionNatureTypeCode",
      "wco:codeCount": {
        "@value": 9,
        "@type": "xsd:integer"
      },
      "dcterms:source": "WCO code list/TransactionNatureTypeCode (n1) + User code (n1)\nRemark:\n* First digit indicates WCO code table value;\n* Second digit can be used as additional user code to further define first digit",
      "wco:codeListSource": "WCO code list/TransactionNatureTypeCode (n1) + User code (n1)\nRemark:\n* First digit indicates WCO code table value;\n* Second digit can be used as additional user code to further define first digit",
      "wco:usedByDataElement": [
        {
          "@id": "wco:dp_103"
        }
      ]
    },
    {
      "@id": "wco:CV_TransactionNatureTypeCode_1",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "wco:CL_TransactionNatureTypeCode"
      },
      "skos:notation": "1",
      "skos:prefLabel": {
        "@value": "1",
        "@language": "en"
      },
      "skos:definition": {
        "@value": "Transactions involving actual or intended transfer of ownership from residents to non-residents against financial or other compensation (except the transactions listed under 2, 7, 8)",
        "@language": "en"
      }
    },
    {
      "@id": "wco:CV_TransactionNatureTypeCode_2",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "wco:CL_TransactionNatureTypeCode"
      },
      "skos:notation": "2",
      "skos:prefLabel": {
        "@value": "2",
        "@language": "en"
      },
      "skos:definition": {
        "@value": "Return and replacement of goods free of charge after registration of the original transaction",
        "@language": "en"
      }
    },
    {
      "@id": "wco:CV_TransactionNatureTypeCode_3",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "wco:CL_TransactionNatureTypeCode"
      },
      "skos:notation": "3",
      "skos:prefLabel": {
        "@value": "3",
        "@language": "en"
      },
      "skos:definition": {
        "@value": "Transactions involving transfer of ownership without financial or in-kind compensation (e.g. aid shipments)",
        "@language": "en"
      }
    },
    {
      "@id": "wco:CV_TransactionNatureTypeCode_4",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "wco:CL_TransactionNatureTypeCode"
      },
      "skos:notation": "4",
      "skos:prefLabel": {
        "@value": "4",
        "@language": "en"
      },
      "skos:definition": {
        "@value": "Operations with a view to processing (2) under contract (no transfer of ownership to the processor)",
        "@language": "en"
      }
    },
    {
      "@id": "wco:CV_TransactionNatureTypeCode_5",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "wco:CL_TransactionNatureTypeCode"
      },
      "skos:notation": "5",
      "skos:prefLabel": {
        "@value": "5",
        "@language": "en"
      },
      "skos:definition": {
        "@value": "Operations following processing under contract (no transfer of ownership to the processor)",
        "@language": "en"
      }
    },
    {
      "@id": "wco:CV_TransactionNatureTypeCode_6",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "wco:CL_TransactionNatureTypeCode"
      },
      "skos:notation": "6",
      "skos:prefLabel": {
        "@value": "6",
        "@language": "en"
      },
      "skos:definition": {
        "@value": "Particular transactions recorded for national purposes",
        "@language": "en"
      }
    },
    {
      "@id": "wco:CV_TransactionNatureTypeCode_7",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "wco:CL_TransactionNatureTypeCode"
      },
      "skos:notation": "7",
      "skos:prefLabel": {
        "@value": "7",
        "@language": "en"
      },
      "skos:definition": {
        "@value": "Operations under joint defence projects or other joint intergovernmental production programmes",
        "@language": "en"
      }
    },
    {
      "@id": "wco:CV_TransactionNatureTypeCode_8",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "wco:CL_TransactionNatureTypeCode"
      },
      "skos:notation": "8",
      "skos:prefLabel": {
        "@value": "8",
        "@language": "en"
      },
      "skos:definition": {
        "@value": "Transactions involving the supply of building materials and technical equipment under a general construction or civil engineering contract for which no separate invoicing of the goods is required and an invoice for the total contract is issued",
        "@language": "en"
      }
    },
    {
      "@id": "wco:CV_TransactionNatureTypeCode_9",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "wco:CL_TransactionNatureTypeCode"
      },
      "skos:notation": "9",
      "skos:prefLabel": {
        "@value": "9",
        "@language": "en"
      },
      "skos:definition": {
        "@value": "Other transactions which cannot be classified under other codes",
        "@language": "en"
      }
    },
