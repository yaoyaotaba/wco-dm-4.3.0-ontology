      "@type": "owl:DatatypeProperty",
      "rdfs:subPropertyOf": {
        "@id": "wco:hasAttribute"
      },
      "rdfs:label": {
        "@value": "Tolerance percentage",
        "@language": "en"
      },
      "skos:definition": {
        "@value": "Percentage of allowable tolerance (e.g. In order to take into account trade-related issues such as weight differences and moisture increase, an importer could enter up to 5% more than for which a certificate was issued. The number 5 will be recorded. Thus, on a certificate issued for 1000 tons, 1050 tons could be realized.\nIn derogation from the general rule, preferential import arrangements may contain provisions showing that there is no tolerance. In such cases, the number 0 is entered).",
        "@language": "en"
      },
      "rdfs:domain": {
        "@id": "wco:C_65A"
      },
      "rdfs:range": {
        "@id": "xsd:decimal"
      },
      "dcterms:identifier": "513",
      "wco:format": "n..10",
      "wco:coreDataType": "Numeric",
      "wco:minOccurs": {
        "@value": 0,
        "@type": "xsd:integer"
      },
      "wco:maxOccurs": {
        "@value": 1,
        "@type": "xsd:integer"
      },
      "wco:usedByClass": [
        {
          "@id": "wco:C_65A"
        }
      ],
      "wco:totalDigits": {
        "@value": 10,
        "@type": "xsd:integer"
      },
      "wco:fractionDigits": {
        "@value": 0,
        "@type": "xsd:integer"
      },
      "wco:xmlTag": "TolerancePercentageNumeric",
      "wco:jsonTag": "tolerancePercentageNumeric"
    },
