# --- Object properties (OIS containment roles) ---------------------------
wco:hasAcceptanceLocation a owl:ObjectProperty ;
  rdfs:subPropertyOf wco:hasComponent ;
  rdfs:label "has acceptance location"@en ;
  skos:definition "Associates a containing WCO DM class with its acceptance location component (AcceptanceLocation)."@en ;
  rdfs:domain [
    a owl:Class ;
    owl:unionOf (
      wco:C_21C
      wco:C_28A
    )
  ] ;
  rdfs:range wco:C_01A ;
  wco:roleName "AcceptanceLocation" ;
  wco:occurrenceCount "2"^^xsd:integer ;
  wco:minOccurs "0"^^xsd:integer ;
  wco:xmlTag "AcceptanceLocation" ;
  wco:jsonTag "acceptanceLocation" ;
  wco:usedByClass wco:C_21C ;
  wco:usedByClass wco:C_28A .

