  wco:usedByClass wco:C_36C .

wco:hasWasteItem a owl:ObjectProperty ;
  rdfs:subPropertyOf wco:hasComponent ;
  rdfs:label "has waste item"@en ;
  skos:definition "Associates a containing WCO DM class with its waste item component (WasteItem)."@en ;
  rdfs:domain [
    a owl:Class ;
    owl:unionOf (
      wco:C_15A
      wco:C_36C
    )
  ] ;
  rdfs:range wco:C_07C ;
  wco:roleName "WasteItem" ;
  wco:occurrenceCount "2"^^xsd:integer ;
  wco:minOccurs "0"^^xsd:integer ;
  wco:xmlTag "WasteItem" ;
  wco:jsonTag "wasteItem" ;
  wco:usedByClass wco:C_15A ;
  wco:usedByClass wco:C_36C .

wco:hasWriteOff a owl:ObjectProperty ;
  rdfs:subPropertyOf wco:hasComponent ;
  rdfs:label "has write off"@en ;
  skos:definition "Associates a containing WCO DM class with its write off component (WriteOff)."@en ;
  rdfs:domain [
    a owl:Class ;
    owl:unionOf (
      wco:C_02A
      wco:C_99A
    )
  ] ;
  rdfs:range wco:C_22C ;
  wco:roleName "WriteOff" ;
  wco:occurrenceCount "3"^^xsd:integer ;
  wco:minOccurs "0"^^xsd:integer ;
  wco:xmlTag "WriteOff" ;
  wco:jsonTag "writeOff" ;
  wco:usedByClass wco:C_02A ;
  wco:usedByClass wco:C_99A .

# --- Datatype properties (global WCO data elements) ----------------------
wco:dp_004 a owl:DatatypeProperty ;
  rdfs:subPropertyOf wco:hasAttribute ;
  rdfs:label "Reservation shipment identifier"@en ;
  skos:definition "Identification of the carrier or its agent to identify a specific consignment by reference number."@en ;
  rdfs:domain wco:C_28A ;
  rdfs:range xsd:string ;
  dcterms:identifier "004" ;
