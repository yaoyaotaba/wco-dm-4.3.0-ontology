wco:dp_513 a owl:DatatypeProperty ;
  rdfs:subPropertyOf wco:hasAttribute ;
  rdfs:label "Tolerance percentage"@en ;
  skos:definition "Percentage of allowable tolerance (e.g. In order to take into account trade-related issues such as weight differences and moisture increase, an importer could enter up to 5% more than for which a certificate was issued. The number 5 will be recorded. Thus, on a certificate issued for 1000 tons, 1050 tons could be realized.\nIn derogation from the general rule, preferential import arrangements may contain provisions showing that there is no tolerance. In such cases, the number 0 is entered)."@en ;
  rdfs:domain wco:C_65A ;
  rdfs:range xsd:decimal ;
