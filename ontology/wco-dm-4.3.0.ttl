  wco:jsonTag "requestOverrideCode" ;
  wco:usedByClass wco:C_03A .

wco:dp_096 a owl:DatatypeProperty ;
  rdfs:subPropertyOf wco:hasAttribute ;
  rdfs:label "Container transport code"@en ;
