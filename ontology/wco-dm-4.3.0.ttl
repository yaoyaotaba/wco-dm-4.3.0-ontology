# --- Annotation properties ------------------------------------------------
wco:classID a owl:AnnotationProperty ; rdfs:label "WCO class identifier"@en .
wco:modelPath a owl:AnnotationProperty ; rdfs:label "OIS model path"@en .
wco:modelPathInstance a owl:AnnotationProperty ; rdfs:label "An OIS path occurrence of the class"@en .
wco:superClass a owl:AnnotationProperty ; rdfs:label "UN/CEFACT superclass alignment recorded in the LIB"@en .
wco:superClassElement a owl:AnnotationProperty ; rdfs:label "UN/CEFACT superclass element alignment recorded in the LIB"@en .
wco:usageContext a owl:AnnotationProperty ; rdfs:label "LIB usage context flag (NONE/DOC/GOV/LOC/PAR/TRA)"@en .
wco:occurrenceCount a owl:AnnotationProperty ; rdfs:label "Number of OIS paths in which the entity occurs"@en .
wco:minOccurs a owl:AnnotationProperty ; rdfs:label "Minimum occurrence count (0; all package rows are optional)"@en .
wco:maxOccurs a owl:AnnotationProperty ; rdfs:label "Maximum occurrence count (data elements: 1; object roles vary by package)"@en .
wco:roleName a owl:AnnotationProperty ; rdfs:label "OIS containment role name"@en .
wco:format a owl:AnnotationProperty ; rdfs:label "WCO LIB format string"@en .
wco:maxLength a owl:AnnotationProperty ; rdfs:label "Maximum lexical length"@en .
wco:minLength a owl:AnnotationProperty ; rdfs:label "Minimum lexical length"@en .
wco:totalDigits a owl:AnnotationProperty ; rdfs:label "Maximum number of decimal digits"@en .
wco:fractionDigits a owl:AnnotationProperty ; rdfs:label "Number of fractional decimal digits"@en .
wco:pattern a owl:AnnotationProperty ; rdfs:label "Regular expression for the lexical form"@en .
wco:coreDataType a owl:AnnotationProperty ; rdfs:label "WCO core data type"@en .
wco:codeList a owl:AnnotationProperty ; rdfs:label "Code-list source string recorded in the LIB"@en .
wco:codeListName a owl:AnnotationProperty ; rdfs:label "Named XML code list matched unambiguously from the LIB catalogue"@en .
wco:usedByClass a owl:AnnotationProperty ; rdfs:label "Class that uses the property"@en .
wco:usedByDataElement a owl:AnnotationProperty ; rdfs:label "Data element that uses the code list"@en .
wco:xmlTag a owl:AnnotationProperty ; rdfs:label "XML element or attribute name"@en .
wco:jsonTag a owl:AnnotationProperty ; rdfs:label "JSON property name"@en .
wco:attrUPI a owl:AnnotationProperty ; rdfs:label "WCO attribute UPI (sample)"@en .
wco:inferredPlacement a owl:AnnotationProperty ; rdfs:label "Placement inferred because the class is absent from the OIS tree"@en .
wco:branch a owl:AnnotationProperty ; rdfs:label "Top-level OIS branch"@en .
wco:codeListSource a owl:AnnotationProperty ; rdfs:label "Code-list source"@en .
wco:codeCount a owl:AnnotationProperty ; rdfs:label "Number of code values published in the LIB"@en .
wco:sha256 a owl:AnnotationProperty ; rdfs:label "SHA-256 checksum"@en .

