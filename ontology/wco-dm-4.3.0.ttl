  wco:xmlTag "AgencyAssignedCustomizationVersionCode" ;
  wco:jsonTag "agencyAssignedCustomizationVersionCode" ;
  wco:usedByClass wco:C_3MD .

wco:dp_MD26 a owl:DatatypeProperty ;
  rdfs:subPropertyOf wco:hasAttribute ;
  rdfs:label "Functional definition"@en ;
  skos:definition "Definition of the function of the message."@en ;
  rdfs:domain wco:C_3MD ;
  rdfs:range xsd:string ;
  dcterms:identifier "MD26" ;
  wco:format "an..512" ;
  wco:coreDataType "Text" ;
  wco:minOccurs "0"^^xsd:integer ;
  wco:maxOccurs "1"^^xsd:integer ;
  wco:maxLength "512"^^xsd:integer ;
  wco:xmlTag "FunctionalDefinition" ;
  wco:jsonTag "functionalDefinition" ;
  wco:usedByClass wco:C_3MD .

wco:dp_R001 a owl:DatatypeProperty ;
  rdfs:subPropertyOf wco:hasAttribute ;
  rdfs:label "Transit principal name"@en ;
  skos:definition "Name of the party accepting liability for goods held or moving under a customs authorization and, when applicable, a guarantee."@en ;
  rdfs:domain wco:C_28B ;
  rdfs:range xsd:string ;
  dcterms:identifier "R001" ;
  wco:format "an..70" ;
  wco:coreDataType "Text" ;
  wco:minOccurs "0"^^xsd:integer ;
  wco:maxOccurs "1"^^xsd:integer ;
  wco:maxLength "70"^^xsd:integer ;
  wco:xmlTag "Name" ;
  wco:jsonTag "name" ;
  wco:superClassElement "S008 name" ;
  wco:usedByClass wco:C_28B .

wco:dp_R002 a owl:DatatypeProperty ;
  rdfs:subPropertyOf wco:hasAttribute ;
  rdfs:label "Transit principal identifier"@en ;
  skos:definition "Identification of the party accepting liability for goods held or moving under a customs authorization and - when applicable - a guarantee."@en ;
  rdfs:domain wco:C_28B ;
  rdfs:range xsd:string ;
  dcterms:identifier "R002" ;
