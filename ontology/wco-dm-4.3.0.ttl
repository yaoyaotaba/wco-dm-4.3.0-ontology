wco:dp_009 a owl:DatatypeProperty ;
  rdfs:subPropertyOf wco:hasAttribute ;
  rdfs:label "Trader reference identifier"@en ;
  skos:definition "Identification of the number assigned by a declarant such as a trader reference or a carrier reference."@en ;
  rdfs:domain wco:C_35B ;
  rdfs:range xsd:string ;
  dcterms:identifier "009" ;
  wco:format "an..35" ;
  wco:coreDataType "Identifier" ;
  wco:minOccurs "0"^^xsd:integer ;
  wco:maxOccurs "1"^^xsd:integer ;
  wco:maxLength "35"^^xsd:integer ;
  wco:xmlTag "TraderAssignedReferenceID" ;
  wco:jsonTag "traderAssignedReferenceId" ;
  wco:usedByClass wco:C_35B .

wco:dp_010 a owl:DatatypeProperty ;
  rdfs:subPropertyOf wco:hasAttribute ;
  rdfs:label "Stay reference identifier"@en ;
  skos:definition "Identification of the stay of a means of transport in a port or airport or other place of service."@en ;
  rdfs:domain wco:C_15A ;
  rdfs:range xsd:string ;
  dcterms:identifier "010" ;
  wco:format "an..35" ;
  wco:coreDataType "Identifier" ;
  wco:minOccurs "0"^^xsd:integer ;
  wco:maxOccurs "1"^^xsd:integer ;
  wco:maxLength "35"^^xsd:integer ;
  wco:xmlTag "StayID" ;
  wco:jsonTag "stayId" ;
  wco:usedByClass wco:C_15A .

wco:dp_011 a owl:DatatypeProperty ;
  rdfs:subPropertyOf wco:hasAttribute ;
  rdfs:label "Carrier split consignment code"@en ;
  skos:definition "Code specifying split consignment for each load assigned by a carrier."@en ;
  rdfs:domain wco:C_28A ;
  rdfs:range xsd:string ;
  dcterms:identifier "011" ;
  wco:format "an..3" ;
  wco:coreDataType "Code" ;
  wco:minOccurs "0"^^xsd:integer ;
  wco:maxOccurs "1"^^xsd:integer ;
  wco:maxLength "3"^^xsd:integer ;
  wco:codeList "UN/EDIFACT code list 7365 subset (codes 156 and 157)" ;
  wco:codeListName "CarrierSplitConsignmentCode" ;
  wco:xmlTag "TransportSplitCode" ;
  wco:jsonTag "transportSplitCode" ;
  wco:usedByClass wco:C_28A .

wco:dp_013 a owl:DatatypeProperty ;
  rdfs:subPropertyOf wco:hasAttribute ;
  rdfs:label "Number of loading lists"@en ;
  skos:definition "Quantity specifying the number of loading lists, manifests or similar documents."@en ;
  rdfs:domain [
    a owl:Class ;
    owl:unionOf (
      wco:C_42A
      wco:C_74B
      wco:C_999
    )
  ] ;
  rdfs:range xsd:decimal ;
  dcterms:identifier "013" ;
  wco:format "n..5" ;
  wco:coreDataType "Quantity" ;
  wco:minOccurs "0"^^xsd:integer ;
  wco:maxOccurs "1"^^xsd:integer ;
  wco:totalDigits "5"^^xsd:integer ;
  wco:fractionDigits "0"^^xsd:integer ;
  wco:xmlTag "LoadingListQuantity" ;
  wco:jsonTag "loadingListQuantity" ;
  wco:usedByClass wco:C_42A ;
  wco:usedByClass wco:C_74B ;
  wco:usedByClass wco:C_999 .

wco:dp_014 a owl:DatatypeProperty ;
  rdfs:subPropertyOf wco:hasAttribute ;
  rdfs:label "Payment identifier"@en ;
  skos:definition "Identification of the payment of a duty or tax by reference number."@en ;
  rdfs:domain wco:C_94A ;
  rdfs:range xsd:string ;
  dcterms:identifier "014" ;
  wco:format "an..35" ;
  wco:coreDataType "Identifier" ;
  wco:minOccurs "0"^^xsd:integer ;
  wco:maxOccurs "1"^^xsd:integer ;
  wco:maxLength "35"^^xsd:integer ;
  wco:xmlTag "ReferenceID" ;
  wco:jsonTag "referenceId" ;
  wco:usedByClass wco:C_94A .

wco:dp_016 a owl:DatatypeProperty ;
  rdfs:subPropertyOf wco:hasAttribute ;
  rdfs:label "UCR identifier"@en ;
  skos:definition "Identification of the unique number assigned to goods being subject to cross border transactions."@en ;
  rdfs:domain wco:C_35B ;
  rdfs:range xsd:string ;
  dcterms:identifier "016" ;
  wco:format "an..35" ;
  wco:coreDataType "Identifier" ;
  wco:minOccurs "0"^^xsd:integer ;
  wco:maxOccurs "1"^^xsd:integer ;
  wco:maxLength "35"^^xsd:integer ;
  wco:codeList "ISO 15459 OR equivalent" ;
  wco:xmlTag "ID" ;
  wco:jsonTag "id" ;
  wco:usedByClass wco:C_35B .

wco:dp_024 a owl:DatatypeProperty ;
  rdfs:subPropertyOf wco:hasAttribute ;
  rdfs:label "Exit date/time"@en ;
  skos:definition "Date and time when the goods depart from last port, airport, or border post of customs territory whence consigned (country of export)."@en ;
  rdfs:domain wco:C_67A ;
  rdfs:range xsd:dateTime ;
  dcterms:identifier "024" ;
  wco:format "an..35" ;
  wco:coreDataType "Date Time" ;
  wco:minOccurs "0"^^xsd:integer ;
  wco:maxOccurs "1"^^xsd:integer ;
  wco:xmlTag "ExitDateTime" ;
  wco:jsonTag "exitDateTime" ;
  wco:usedByClass wco:C_67A .

wco:dp_025 a owl:DatatypeProperty ;
  rdfs:subPropertyOf wco:hasAttribute ;
  rdfs:label "Vanning date/time"@en ;
  skos:definition "Date and time of loading cargo into a container."@en ;
  rdfs:domain wco:C_16B ;
  rdfs:range xsd:dateTime ;
  dcterms:identifier "025" ;
  wco:format "an..35" ;
  wco:coreDataType "Date Time" ;
  wco:minOccurs "0"^^xsd:integer ;
  wco:maxOccurs "1"^^xsd:integer ;
  wco:xmlTag "StuffingDateTime" ;
  wco:jsonTag "stuffingDateTime" ;
  wco:usedByClass wco:C_16B .

wco:dp_027 a owl:DatatypeProperty ;
  rdfs:subPropertyOf wco:hasAttribute ;
  rdfs:label "Transit control days quantity"@en ;
  skos:definition "Quantity specifying the number of days a consignment is under transit control."@en ;
  rdfs:domain wco:C_24B ;
  rdfs:range xsd:decimal ;
  dcterms:identifier "027" ;
  wco:format "n..2" ;
  wco:coreDataType "Quantity" ;
  wco:minOccurs "0"^^xsd:integer ;
  wco:maxOccurs "1"^^xsd:integer ;
  wco:totalDigits "2"^^xsd:integer ;
  wco:fractionDigits "0"^^xsd:integer ;
  wco:xmlTag "DurationInDaysQuantity" ;
  wco:jsonTag "durationInDaysQuantity" ;
  wco:usedByClass wco:C_24B .

wco:dp_029 a owl:DatatypeProperty ;
  rdfs:subPropertyOf wco:hasAttribute ;
  rdfs:label "Consignment unloading date/time"@en ;
  skos:definition "Date and time the cargo was outturned."@en ;
  rdfs:domain wco:C_15A ;
  rdfs:range xsd:dateTime ;
  dcterms:identifier "029" ;
  wco:format "an..35" ;
  wco:coreDataType "Date Time" ;
  wco:minOccurs "0"^^xsd:integer ;
  wco:maxOccurs "1"^^xsd:integer ;
  wco:xmlTag "DischargeCompletedDateTime" ;
  wco:jsonTag "dischargeCompletedDateTime" ;
  wco:usedByClass wco:C_15A .

wco:dp_030 a owl:DatatypeProperty ;
  rdfs:subPropertyOf wco:hasAttribute ;
  rdfs:label "Departure date/time"@en ;
  skos:definition "Date and time of the departure of the goods from original consignor."@en ;
  rdfs:domain wco:C_67A ;
  rdfs:range xsd:dateTime ;
  dcterms:identifier "030" ;
  wco:format "an..35" ;
  wco:coreDataType "Date Time" ;
  wco:minOccurs "0"^^xsd:integer ;
  wco:maxOccurs "1"^^xsd:integer ;
  wco:xmlTag "DispatchDateTime" ;
  wco:jsonTag "dispatchDateTime" ;
  wco:usedByClass wco:C_67A .

wco:dp_031 a owl:DatatypeProperty ;
  rdfs:subPropertyOf wco:hasAttribute ;
  rdfs:label "Consignment loading date/time"@en ;
  skos:definition "Date and time of initial loading onto a ship or airplane during one journey from export location to import location."@en ;
  rdfs:domain wco:C_83A ;
  rdfs:range xsd:dateTime ;
  dcterms:identifier "031" ;
  wco:format "an..35" ;
  wco:coreDataType "Date Time" ;
  wco:minOccurs "0"^^xsd:integer ;
  wco:maxOccurs "1"^^xsd:integer ;
  wco:xmlTag "LoadingDateTime" ;
  wco:jsonTag "loadingDateTime" ;
  wco:usedByClass wco:C_83A .

wco:dp_062 a owl:DatatypeProperty ;
  rdfs:subPropertyOf wco:hasAttribute ;
  rdfs:label "Country of exportation code"@en ;
  skos:definition "Code specifying the country from which the goods are originally exported without any commercial transaction taken place in intermediate countries."@en ;
  rdfs:domain wco:C_95B ;
  rdfs:range xsd:string ;
  dcterms:identifier "062" ;
  wco:format "a2" ;
  wco:coreDataType "Code" ;
  wco:minOccurs "0"^^xsd:integer ;
  wco:maxOccurs "1"^^xsd:integer ;
  wco:maxLength "2"^^xsd:integer ;
  wco:minLength "2"^^xsd:integer ;
  wco:pattern "[A-Za-z]{2}" ;
  wco:codeList "ISO 3166-1" ;
  wco:codeListName "CountryCode" ;
  wco:xmlTag "CountryCode" ;
  wco:jsonTag "countryCode" ;
  wco:usedByClass wco:C_95B .

wco:dp_063 a owl:DatatypeProperty ;
  rdfs:subPropertyOf wco:hasAttribute ;
  rdfs:label "Country of origin code"@en ;
  skos:definition "Code specifying the country in which the goods have been produced or manufactured, according to criteria laid down for the application of the Customs tariff or quantitative restrictions, or any measure related to trade."@en ;
  rdfs:domain wco:C_92A ;
  rdfs:range xsd:string ;
  dcterms:identifier "063" ;
  wco:format "a2" ;
  wco:coreDataType "Code" ;
  wco:minOccurs "0"^^xsd:integer ;
  wco:maxOccurs "1"^^xsd:integer ;
  wco:maxLength "2"^^xsd:integer ;
  wco:minLength "2"^^xsd:integer ;
  wco:pattern "[A-Za-z]{2}" ;
  wco:codeList "ISO 3166-1" ;
  wco:codeListName "CountryCode" ;
  wco:xmlTag "CountryCode" ;
  wco:jsonTag "countryCode" ;
  wco:usedByClass wco:C_92A .

wco:dp_064 a owl:DatatypeProperty ;
  rdfs:subPropertyOf wco:hasAttribute ;
  rdfs:label "Country of routing code"@en ;
  skos:definition "Code specifying the country through which goods or passengers are routed between the country of original departure and final destination."@en ;
  rdfs:domain wco:C_81A ;
  rdfs:range xsd:string ;
  dcterms:identifier "064" ;
  wco:format "a2" ;
  wco:coreDataType "Code" ;
  wco:minOccurs "0"^^xsd:integer ;
  wco:maxOccurs "1"^^xsd:integer ;
  wco:maxLength "2"^^xsd:integer ;
  wco:minLength "2"^^xsd:integer ;
  wco:pattern "[A-Za-z]{2}" ;
  wco:codeList "ISO 3166-1" ;
  wco:codeListName "CountryCode" ;
  wco:xmlTag "RoutingCountryCode" ;
  wco:jsonTag "routingCountryCode" ;
  wco:usedByClass wco:C_81A .

wco:dp_066 a owl:DatatypeProperty ;
  rdfs:subPropertyOf wco:hasAttribute ;
  rdfs:label "Region of origin identifier"@en ;
  skos:definition "Identification of the region in which the goods have been produced or manufactured, according to criteria laid down for the purposes of application of the Customs tariff, or quantitative restrictions, or of any other measure related to trade."@en ;
  rdfs:domain wco:C_92A ;
  rdfs:range xsd:string ;
  dcterms:identifier "066" ;
  wco:format "an..9" ;
  wco:coreDataType "Identifier" ;
  wco:minOccurs "0"^^xsd:integer ;
  wco:maxOccurs "1"^^xsd:integer ;
  wco:maxLength "9"^^xsd:integer ;
  wco:xmlTag "RegionID" ;
  wco:jsonTag "regionId" ;
  wco:usedByClass wco:C_92A .

wco:dp_088 a owl:DatatypeProperty ;
  rdfs:subPropertyOf wco:hasAttribute ;
  rdfs:label "Region of export identifier"@en ;
  skos:definition "Identification of country subdivision where goods begin their journey to export location."@en ;
  rdfs:domain wco:C_95B ;
  rdfs:range xsd:string ;
  dcterms:identifier "088" ;
  wco:format "an..9" ;
  wco:coreDataType "Identifier" ;
  wco:minOccurs "0"^^xsd:integer ;
  wco:maxOccurs "1"^^xsd:integer ;
  wco:maxLength "9"^^xsd:integer ;
  wco:xmlTag "RegionID" ;
  wco:jsonTag "regionId" ;
  wco:usedByClass wco:C_95B .

wco:dp_089 a owl:DatatypeProperty ;
  rdfs:subPropertyOf wco:hasAttribute ;
  rdfs:label "Incoterms description"@en ;
  skos:definition "Description of delivery or transport terms."@en ;
  rdfs:domain wco:C_22B ;
  rdfs:range xsd:string ;
  dcterms:identifier "089" ;
  wco:format "an..70" ;
  wco:coreDataType "Text" ;
  wco:minOccurs "0"^^xsd:integer ;
  wco:maxOccurs "1"^^xsd:integer ;
  wco:maxLength "70"^^xsd:integer ;
  wco:xmlTag "Description" ;
  wco:jsonTag "description" ;
  wco:usedByClass wco:C_22B .

wco:dp_090 a owl:DatatypeProperty ;
  rdfs:subPropertyOf wco:hasAttribute ;
  rdfs:label "Incoterms code"@en ;
  skos:definition "Code specifying the delivery or transport terms."@en ;
  rdfs:domain wco:C_22B ;
  rdfs:range xsd:string ;
  dcterms:identifier "090" ;
  wco:format "a3" ;
  wco:coreDataType "Code" ;
  wco:minOccurs "0"^^xsd:integer ;
  wco:maxOccurs "1"^^xsd:integer ;
  wco:maxLength "3"^^xsd:integer ;
  wco:minLength "3"^^xsd:integer ;
  wco:pattern "[A-Za-z]{3}" ;
  wco:codeList "UN/EDIFACT code list 4053" ;
  wco:codeListName "TradetermConditionCode" ;
  wco:xmlTag "ConditionCode" ;
  wco:jsonTag "conditionCode" ;
  wco:usedByClass wco:C_22B .

wco:dp_091 a owl:DatatypeProperty ;
  rdfs:subPropertyOf wco:hasAttribute ;
  rdfs:label "Contract and carriage condition code"@en ;
  skos:definition "Code specifying the conditions of contract and carriage."@en ;
  rdfs:domain [
    a owl:Class ;
    owl:unionOf (
      wco:C_30B
      wco:C_31B
    )
  ] ;
  rdfs:range xsd:string ;
  dcterms:identifier "091" ;
  wco:format "an..3" ;
  wco:coreDataType "Code" ;
  wco:minOccurs "0"^^xsd:integer ;
  wco:maxOccurs "1"^^xsd:integer ;
  wco:maxLength "3"^^xsd:integer ;
  wco:codeList "UN/EDIFACT code list 4065" ;
  wco:codeListName "TransportContractDocumentConditionCode" ;
  wco:xmlTag "ConditionCode" ;
  wco:jsonTag "conditionCode" ;
  wco:usedByClass wco:C_30B ;
  wco:usedByClass wco:C_31B .

wco:dp_092 a owl:DatatypeProperty ;
  rdfs:subPropertyOf wco:hasAttribute ;
  rdfs:label "Handling instructions"@en ;
  skos:definition "Directions for handling a consignment and/or delivery directions for a shipment."@en ;
  rdfs:domain wco:C_73A ;
  rdfs:range xsd:string ;
  dcterms:identifier "092" ;
  wco:format "an..256" ;
  wco:coreDataType "Text" ;
  wco:minOccurs "0"^^xsd:integer ;
  wco:maxOccurs "1"^^xsd:integer ;
  wco:maxLength "256"^^xsd:integer ;
  wco:xmlTag "Instructions" ;
  wco:jsonTag "instructions" ;
  wco:usedByClass wco:C_73A .

wco:dp_093 a owl:DatatypeProperty ;
  rdfs:subPropertyOf wco:hasAttribute ;
  rdfs:label "Handling instructions code"@en ;
  skos:definition "Code specifying the directions for handling a shipment and/or delivery for a shipment."@en ;
  rdfs:domain wco:C_73A ;
  rdfs:range xsd:string ;
  dcterms:identifier "093" ;
  wco:format "an..3" ;
  wco:coreDataType "Code" ;
  wco:minOccurs "0"^^xsd:integer ;
  wco:maxOccurs "1"^^xsd:integer ;
  wco:maxLength "3"^^xsd:integer ;
  wco:codeList "UN/EDIFACT code list 4079" ;
  wco:codeListName "HandlingCode" ;
  wco:xmlTag "InstructionsCode" ;
  wco:jsonTag "instructionsCode" ;
  wco:usedByClass wco:C_73A .

wco:dp_094 a owl:DatatypeProperty ;
  rdfs:subPropertyOf wco:hasAttribute ;
  rdfs:label "Goods status code"@en ;
  skos:definition "Code specifying the status of goods as identified by customs for regulation purposes or as a result of an action by the declarant or government agency."@en ;
  rdfs:domain [
    a owl:Class ;
    owl:unionOf (
      wco:C_28A
      wco:C_29A
      wco:C_67A
      wco:C_68A
    )
  ] ;
  rdfs:range xsd:string ;
  dcterms:identifier "094" ;
  wco:format "an..3" ;
  wco:coreDataType "Code" ;
  wco:minOccurs "0"^^xsd:integer ;
  wco:maxOccurs "1"^^xsd:integer ;
  wco:maxLength "3"^^xsd:integer ;
  wco:codeList "UN/EDIFACT code list 4405 OR User code list" ;
  wco:xmlTag "GoodsStatusCode" ;
  wco:jsonTag "goodsStatusCode" ;
  wco:usedByClass wco:C_28A ;
  wco:usedByClass wco:C_29A ;
  wco:usedByClass wco:C_67A ;
  wco:usedByClass wco:C_68A .

wco:dp_095 a owl:DatatypeProperty ;
  rdfs:subPropertyOf wco:hasAttribute ;
  rdfs:label "Error condition override code"@en ;
  skos:definition "Code specifying a request to override automatic processing procedures."@en ;
  rdfs:domain wco:C_03A ;
  rdfs:range xsd:string ;
  dcterms:identifier "095" ;
  wco:format "an..3" ;
  wco:coreDataType "Code" ;
