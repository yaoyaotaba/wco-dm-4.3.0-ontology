  dcterms:identifier "L120" ;
  wco:format "an..256" ;
  wco:coreDataType "Text" ;
  wco:minOccurs "0"^^xsd:integer ;
  wco:maxOccurs "1"^^xsd:integer ;
  wco:maxLength "256"^^xsd:integer ;
  wco:xmlTag "Name" ;
  wco:jsonTag "name" ;
  wco:superClassElement "S002 name" ;
  wco:usedByClass wco:C_74C .

wco:dp_L121 a owl:DatatypeProperty ;
  rdfs:subPropertyOf wco:hasAttribute ;
  rdfs:label "Berth location identifier"@en ;
  skos:definition "Identification of the location in port where the means of transport will berth."@en ;
  rdfs:domain wco:C_74C ;
  rdfs:range xsd:string ;
  dcterms:identifier "L121" ;
  wco:format "an..35" ;
  wco:coreDataType "Identifier" ;
  wco:minOccurs "0"^^xsd:integer ;
  wco:maxOccurs "1"^^xsd:integer ;
  wco:maxLength "35"^^xsd:integer ;
  wco:codeList "UN/LOCODE + User codes" ;
  wco:xmlTag "ID" ;
  wco:jsonTag "id" ;
  wco:superClassElement "S003 identification" ;
  wco:usedByClass wco:C_74C .

wco:dp_MD01 a owl:DatatypeProperty ;
  rdfs:subPropertyOf wco:hasAttribute ;
  rdfs:label "Acknowledgement request indicator"@en ;
  skos:definition "Indicator requesting acknowledgement of the interchange."@en ;
  rdfs:domain wco:C_1MD ;
  rdfs:range xsd:boolean ;
  dcterms:identifier "MD01" ;
  wco:format "n1" ;
  wco:coreDataType "Indicator" ;
  wco:minOccurs "0"^^xsd:integer ;
  wco:maxOccurs "1"^^xsd:integer ;
  wco:xmlTag "AcknowledgementRequestIndicator" ;
  wco:jsonTag "acknowledgementRequestIndicator" ;
  wco:usedByClass wco:C_1MD .

wco:dp_MD02 a owl:DatatypeProperty ;
  rdfs:subPropertyOf wco:hasAttribute ;
  rdfs:label "Application reference identifier"@en ;
  skos:definition "Identification of the application area assigned by the sender, to which the messages in the interchange relate (e.g. the message identifier if all the messages in the interchange are of the same type)."@en ;
  rdfs:domain wco:C_1MD ;
  rdfs:range xsd:string ;
  dcterms:identifier "MD02" ;
  wco:format "an..70" ;
  wco:coreDataType "Identifier" ;
  wco:minOccurs "0"^^xsd:integer ;
  wco:maxOccurs "1"^^xsd:integer ;
  wco:maxLength "70"^^xsd:integer ;
  wco:xmlTag "ApplicationReferenceID" ;
  wco:jsonTag "applicationReferenceId" ;
  wco:usedByClass wco:C_1MD .

wco:dp_MD03 a owl:DatatypeProperty ;
  rdfs:subPropertyOf wco:hasAttribute ;
  rdfs:label "Communications agreement identifier"@en ;
  skos:definition "Identification of the type of agreement under which the interchange takes place by name or code."@en ;
  rdfs:domain wco:C_1MD ;
  rdfs:range xsd:string ;
  dcterms:identifier "MD03" ;
  wco:format "an..35" ;
  wco:coreDataType "Identifier" ;
  wco:minOccurs "0"^^xsd:integer ;
  wco:maxOccurs "1"^^xsd:integer ;
  wco:maxLength "35"^^xsd:integer ;
  wco:xmlTag "CommunicationsAgreementID" ;
  wco:jsonTag "communicationsAgreementId" ;
  wco:usedByClass wco:C_1MD .

wco:dp_MD04 a owl:DatatypeProperty ;
  rdfs:subPropertyOf wco:hasAttribute ;
  rdfs:label "Preparation date/time"@en ;
  skos:definition "Date and time locally when an interchange or a functional group was prepared."@en ;
  rdfs:domain wco:C_1MD ;
  rdfs:range xsd:dateTime ;
  dcterms:identifier "MD04" ;
  wco:format "an..35" ;
  wco:coreDataType "Date Time" ;
  wco:minOccurs "0"^^xsd:integer ;
  wco:maxOccurs "1"^^xsd:integer ;
  wco:xmlTag "PreparationDateTime" ;
  wco:jsonTag "preparationDateTime" ;
  wco:usedByClass wco:C_1MD .

wco:dp_MD05 a owl:DatatypeProperty ;
  rdfs:subPropertyOf wco:hasAttribute ;
  rdfs:label "Syntax identification code"@en ;
  skos:definition "Code specifying the agency controlling a syntax and syntax level used in an interchange."@en ;
  rdfs:domain wco:C_1MD ;
  rdfs:range xsd:string ;
  dcterms:identifier "MD05" ;
  wco:format "a4" ;
  wco:coreDataType "Code" ;
  wco:minOccurs "0"^^xsd:integer ;
  wco:maxOccurs "1"^^xsd:integer ;
  wco:maxLength "4"^^xsd:integer ;
  wco:minLength "4"^^xsd:integer ;
  wco:pattern "[A-Za-z]{4}" ;
  wco:codeList "UN/EDIFACT code list 0001" ;
  wco:codeListName "SyntaxIdentifierCode" ;
  wco:xmlTag "SyntaxIdentificationCode" ;
  wco:jsonTag "syntaxIdentificationCode" ;
  wco:usedByClass wco:C_1MD .

wco:dp_MD06 a owl:DatatypeProperty ;
  rdfs:subPropertyOf wco:hasAttribute ;
  rdfs:label "Syntax version code"@en ;
  skos:definition "Code specifying the version number of the syntax identified in the syntax identifier (e.g. 0001)."@en ;
  rdfs:domain wco:C_1MD ;
  rdfs:range xsd:decimal ;
  dcterms:identifier "MD06" ;
  wco:format "n1" ;
  wco:coreDataType "Code" ;
  wco:minOccurs "0"^^xsd:integer ;
  wco:maxOccurs "1"^^xsd:integer ;
  wco:totalDigits "1"^^xsd:integer ;
  wco:fractionDigits "0"^^xsd:integer ;
  wco:codeList "UN/EDIFACT code list 0002" ;
  wco:codeListName "SyntaxVersionCode" ;
  wco:xmlTag "SyntaxVersionCode" ;
  wco:jsonTag "syntaxVersionCode" ;
  wco:usedByClass wco:C_1MD .

wco:dp_MD07 a owl:DatatypeProperty ;
  rdfs:subPropertyOf wco:hasAttribute ;
  rdfs:label "Test indicator"@en ;
  skos:definition "Indicator that the interchange is a test."@en ;
  rdfs:domain wco:C_1MD ;
  rdfs:range xsd:boolean ;
  dcterms:identifier "MD07" ;
  wco:format "n1" ;
  wco:coreDataType "Indicator" ;
  wco:minOccurs "0"^^xsd:integer ;
  wco:maxOccurs "1"^^xsd:integer ;
  wco:xmlTag "TestIndicator" ;
  wco:jsonTag "testIndicator" ;
  wco:usedByClass wco:C_1MD .

wco:dp_MD09 a owl:DatatypeProperty ;
  rdfs:subPropertyOf wco:hasAttribute ;
  rdfs:label "Business process context identifier"@en ;
  skos:definition "Identification of the interaction between trading partners to achieve a given business objective."@en ;
  rdfs:domain wco:C_2MD ;
  rdfs:range xsd:string ;
  dcterms:identifier "MD09" ;
  wco:format "an..35" ;
  wco:coreDataType "Identifier" ;
  wco:minOccurs "0"^^xsd:integer ;
  wco:maxOccurs "1"^^xsd:integer ;
  wco:maxLength "35"^^xsd:integer ;
  wco:codeList "These values will be summarized and will be hierarchical where applicable. \nThis list can be extended.\nDefault value \"ALL\" if no restrictions apply." ;
  wco:xmlTag "BusinessProcessID" ;
  wco:jsonTag "businessProcessId" ;
  wco:usedByClass wco:C_2MD .

wco:dp_MD10 a owl:DatatypeProperty ;
  rdfs:subPropertyOf wco:hasAttribute ;
  rdfs:label "Product classification context identifier"@en ;
  skos:definition "Identification of the goods or services concerned in the collaboration."@en ;
  rdfs:domain wco:C_2MD ;
  rdfs:range xsd:string ;
  dcterms:identifier "MD10" ;
  wco:format "an..35" ;
  wco:coreDataType "Identifier" ;
  wco:minOccurs "0"^^xsd:integer ;
  wco:maxOccurs "1"^^xsd:integer ;
  wco:maxLength "35"^^xsd:integer ;
  wco:codeList "Use relevant HS codes OR text.\nDefault value \"ALL\" if no restrictions apply." ;
  wco:xmlTag "ProductClassificationID" ;
  wco:jsonTag "productClassificationId" ;
  wco:usedByClass wco:C_2MD .

wco:dp_MD11 a owl:DatatypeProperty ;
  rdfs:subPropertyOf wco:hasAttribute ;
  rdfs:label "Industry classification context identifier"@en ;
  skos:definition "Identification of the relevant trading partner industries."@en ;
  rdfs:domain wco:C_2MD ;
  rdfs:range xsd:string ;
  dcterms:identifier "MD11" ;
  wco:format "an..35" ;
  wco:coreDataType "Identifier" ;
  wco:minOccurs "0"^^xsd:integer ;
  wco:maxOccurs "1"^^xsd:integer ;
  wco:maxLength "35"^^xsd:integer ;
  wco:codeList "UN International Standard Industrial Classification (ISIC).\nDefault value \"ALL\" if no restrictions apply." ;
  wco:xmlTag "IndustryClassificationID" ;
  wco:jsonTag "industryClassificationId" ;
  wco:usedByClass wco:C_2MD .

wco:dp_MD12 a owl:DatatypeProperty ;
  rdfs:subPropertyOf wco:hasAttribute ;
  rdfs:label "Geopolitical context identifier"@en ;
  skos:definition "Identification of where the business process is to be conducted."@en ;
  rdfs:domain wco:C_2MD ;
  rdfs:range xsd:string ;
  dcterms:identifier "MD12" ;
  wco:format "an..35" ;
  wco:coreDataType "Identifier" ;
  wco:minOccurs "0"^^xsd:integer ;
  wco:maxOccurs "1"^^xsd:integer ;
  wco:maxLength "35"^^xsd:integer ;
  wco:codeList "ISO 3166 including ISO 3166_1 and ISO 3166_2.\nDefault value \"ALL\" if no restrictions apply." ;
  wco:xmlTag "GeopoliticalID" ;
  wco:jsonTag "geopoliticalId" ;
  wco:usedByClass wco:C_2MD .

wco:dp_MD13 a owl:DatatypeProperty ;
  rdfs:subPropertyOf wco:hasAttribute ;
  rdfs:label "Official constraints context identifier"@en ;
  skos:definition "Identification of any legal restrictions or requirements on this business process."@en ;
  rdfs:domain wco:C_2MD ;
  rdfs:range xsd:string ;
  dcterms:identifier "MD13" ;
  wco:format "an..35" ;
  wco:coreDataType "Identifier" ;
  wco:minOccurs "0"^^xsd:integer ;
  wco:maxOccurs "1"^^xsd:integer ;
  wco:maxLength "35"^^xsd:integer ;
  wco:codeList "Proposed guideline: Use relevant laws, treaties OR regulations : User code list and abbreviations are allowed. \nDefault value \"NONE\" if no restrictions apply." ;
  wco:xmlTag "OfficialConstraintslID" ;
  wco:jsonTag "officialConstraintslId" ;
  wco:usedByClass wco:C_2MD .

wco:dp_MD14 a owl:DatatypeProperty ;
  rdfs:subPropertyOf wco:hasAttribute ;
  rdfs:label "Business process role context identifier"@en ;
  skos:definition "Identification of the roles played by the trading partners. \nThese can be derived from the Business Process."@en ;
  rdfs:domain wco:C_2MD ;
  rdfs:range xsd:string ;
  dcterms:identifier "MD14" ;
  wco:format "an..35" ;
  wco:coreDataType "Identifier" ;
  wco:minOccurs "0"^^xsd:integer ;
  wco:maxOccurs "1"^^xsd:integer ;
  wco:maxLength "35"^^xsd:integer ;
  wco:codeList "To be supplied by the producer of My IP.\nDefault value \"ALL\" if no restrictions apply. \n<Examples: Broker, ImpORter, forwarder etc." ;
  wco:xmlTag "BusinessProcessRoleID" ;
  wco:jsonTag "businessProcessRoleId" ;
  wco:usedByClass wco:C_2MD .

wco:dp_MD15 a owl:DatatypeProperty ;
  rdfs:subPropertyOf wco:hasAttribute ;
  rdfs:label "Supporting role context identifier"@en ;
  skos:definition "Identification of other significant parties that will be using the data in the messages. Determine their role in the overall process."@en ;
  rdfs:domain wco:C_2MD ;
  rdfs:range xsd:string ;
  dcterms:identifier "MD15" ;
  wco:format "an..35" ;
  wco:coreDataType "Identifier" ;
  wco:minOccurs "0"^^xsd:integer ;
  wco:maxOccurs "1"^^xsd:integer ;
  wco:maxLength "35"^^xsd:integer ;
  wco:codeList "To be supplied by the producer of My IP.\nDefault value \"ALL\" if no restrictions apply." ;
  wco:xmlTag "SupportingRoleID" ;
  wco:jsonTag "supportingRoleId" ;
  wco:usedByClass wco:C_2MD .

wco:dp_MD16 a owl:DatatypeProperty ;
  rdfs:subPropertyOf wco:hasAttribute ;
  rdfs:label "System capabilities context identifier"@en ;
  skos:definition "Identification of major restrictions derived from system, a class of systems or standard in the business situation. Identify the type of system."@en ;
  rdfs:domain wco:C_2MD ;
  rdfs:range xsd:string ;
  dcterms:identifier "MD16" ;
  wco:format "an..35" ;
  wco:coreDataType "Identifier" ;
  wco:minOccurs "0"^^xsd:integer ;
  wco:maxOccurs "1"^^xsd:integer ;
  wco:maxLength "35"^^xsd:integer ;
  wco:codeList "To be supplied by the producer of My IP.\nDefault value \"ALL\" if no restrictions apply." ;
  wco:xmlTag "SystemCapabilitiesID" ;
  wco:jsonTag "systemCapabilitiesId" ;
  wco:usedByClass wco:C_2MD .

wco:dp_MD17 a owl:DatatypeProperty ;
  rdfs:subPropertyOf wco:hasAttribute ;
  rdfs:label "WCO Data Model version code"@en ;
  skos:definition "Code specifying the version of the WCO Data Model (e.g. 3.40)."@en ;
  rdfs:domain wco:C_3MD ;
  rdfs:range xsd:string ;
  dcterms:identifier "MD17" ;
  wco:format "an..6" ;
  wco:coreDataType "Code" ;
  wco:minOccurs "0"^^xsd:integer ;
  wco:maxOccurs "1"^^xsd:integer ;
  wco:maxLength "6"^^xsd:integer ;
  wco:codeList "WCO code list/WCODataModelVersion" ;
  wco:xmlTag "WCODataModelVersionCode" ;
  wco:jsonTag "wcoDataModelVersionCode" ;
  wco:usedByClass wco:C_3MD .

wco:dp_MD18 a owl:DatatypeProperty ;
  rdfs:subPropertyOf wco:hasAttribute ;
  rdfs:label "WCO category code"@en ;
  skos:definition "Code specifying the category within the WCO Data Model."@en ;
  rdfs:domain wco:C_3MD ;
  rdfs:range xsd:string ;
  dcterms:identifier "MD18" ;
  wco:format "an..3" ;
  wco:coreDataType "Code" ;
  wco:minOccurs "0"^^xsd:integer ;
  wco:maxOccurs "1"^^xsd:integer ;
  wco:maxLength "3"^^xsd:integer ;
  wco:codeList "WCO code list/WCOCategory" ;
  wco:xmlTag "WCOCategoryCode" ;
  wco:jsonTag "wcoCategoryCode" ;
  wco:usedByClass wco:C_3MD .

wco:dp_MD19 a owl:DatatypeProperty ;
  rdfs:subPropertyOf wco:hasAttribute ;
  rdfs:label "Message type code"@en ;
  skos:definition "Code specifying the WCO Type."@en ;
  rdfs:domain wco:C_3MD ;
  rdfs:range xsd:string ;
  dcterms:identifier "MD19" ;
  wco:format "an..6" ;
  wco:coreDataType "Code" ;
  wco:minOccurs "0"^^xsd:integer ;
  wco:maxOccurs "1"^^xsd:integer ;
  wco:maxLength "6"^^xsd:integer ;
  wco:codeList "WCO code list/WCOType" ;
  wco:xmlTag "WCOTypeCode" ;
  wco:jsonTag "wcoTypeCode" ;
  wco:usedByClass wco:C_3MD .

wco:dp_MD21 a owl:DatatypeProperty ;
  rdfs:subPropertyOf wco:hasAttribute ;
  rdfs:label "Responsible country code"@en ;
  skos:definition "Code specifying the country controlling the specification, maintenance and publication of the message type."@en ;
  rdfs:domain wco:C_3MD ;
  rdfs:range xsd:string ;
  dcterms:identifier "MD21" ;
  wco:format "a2" ;
  wco:coreDataType "Code" ;
  wco:minOccurs "0"^^xsd:integer ;
  wco:maxOccurs "1"^^xsd:integer ;
  wco:maxLength "2"^^xsd:integer ;
  wco:minLength "2"^^xsd:integer ;
  wco:pattern "[A-Za-z]{2}" ;
  wco:codeList "ISO 3166-1" ;
  wco:codeListName "CountryCode" ;
  wco:xmlTag "ResponsibleCountryCode" ;
  wco:jsonTag "responsibleCountryCode" ;
  wco:usedByClass wco:C_3MD .

wco:dp_MD22 a owl:DatatypeProperty ;
  rdfs:subPropertyOf wco:hasAttribute ;
  rdfs:label "Responsible agency code"@en ;
  skos:definition "Code specifying the agency controlling the specification, maintenance and publication of the message type."@en ;
  rdfs:domain wco:C_3MD ;
  rdfs:range xsd:string ;
  dcterms:identifier "MD22" ;
  wco:format "an..2" ;
  wco:coreDataType "Code" ;
  wco:minOccurs "0"^^xsd:integer ;
  wco:maxOccurs "1"^^xsd:integer ;
  wco:maxLength "2"^^xsd:integer ;
  wco:codeList "UN/EDIFACT code list 0051" ;
  wco:codeListName "ResponsibleAgencyCode" ;
  wco:xmlTag "ResponsibleAgencyCode" ;
  wco:jsonTag "responsibleAgencyCode" ;
  wco:usedByClass wco:C_3MD .

wco:dp_MD23 a owl:DatatypeProperty ;
  rdfs:subPropertyOf wco:hasAttribute ;
  rdfs:label "Responsible agency name"@en ;
  skos:definition "Name to identify the agency controlling the specification, maintenance and publication of the message type."@en ;
  rdfs:domain wco:C_3MD ;
  rdfs:range xsd:string ;
  dcterms:identifier "MD23" ;
  wco:format "an..70" ;
  wco:coreDataType "Text" ;
  wco:minOccurs "0"^^xsd:integer ;
  wco:maxOccurs "1"^^xsd:integer ;
  wco:maxLength "70"^^xsd:integer ;
  wco:xmlTag "ResponsibleAgencyName" ;
  wco:jsonTag "responsibleAgencyName" ;
  wco:usedByClass wco:C_3MD .

wco:dp_MD24 a owl:DatatypeProperty ;
  rdfs:subPropertyOf wco:hasAttribute ;
  rdfs:label "Agency assigned customization code"@en ;
  skos:definition "Code specifying the agency responsible for the design and maintenance of the message type concerned, which further identifies the message."@en ;
  rdfs:domain wco:C_3MD ;
  rdfs:range xsd:string ;
  dcterms:identifier "MD24" ;
  wco:format "an..6" ;
  wco:coreDataType "Code" ;
  wco:minOccurs "0"^^xsd:integer ;
  wco:maxOccurs "1"^^xsd:integer ;
  wco:maxLength "6"^^xsd:integer ;
  wco:codeList "User code list" ;
  wco:xmlTag "AgencyAssignedCustomizationCode" ;
  wco:jsonTag "agencyAssignedCustomizationCode" ;
  wco:usedByClass wco:C_3MD .

wco:dp_MD25 a owl:DatatypeProperty ;
  rdfs:subPropertyOf wco:hasAttribute ;
  rdfs:label "Agency assigned customization version code"@en ;
  skos:definition "Code specifying the version of the agency assigned customization."@en ;
  rdfs:domain wco:C_3MD ;
  rdfs:range xsd:string ;
  dcterms:identifier "MD25" ;
  wco:format "an..3" ;
  wco:coreDataType "Code" ;
  wco:minOccurs "0"^^xsd:integer ;
  wco:maxOccurs "1"^^xsd:integer ;
  wco:maxLength "3"^^xsd:integer ;
